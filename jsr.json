{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@docxcelerate/docxcelerate",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./src/public.ts",
    "./cli": "./src/project/scaffold_cli.ts",
    "./document": "./src/document.ts",
    "./docx": "./src/render/docx_document.ts",
    "./renderer": "./src/renderer/mod.ts",
    "./scaffold": "./src/project/scaffold.ts",
    "./template": "./src/template.ts",
    "./template/jsx-dev-runtime": "./src/template/jsx-dev-runtime.ts",
    "./template/jsx-runtime": "./src/template/jsx-runtime.ts"
  },
  "imports": {
    "docx": "npm:docx@^9.6.1"
  },
  "publish": {
    "include": ["src", "README.md", "jsr.json"]
  }
}
