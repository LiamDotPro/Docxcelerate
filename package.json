{
  "name": "docxcelerate",
  "version": "0.4.2",
  "description": "Write DOCX documents like you write websites — compose Word files from typed JSX components, preview them locally, generate at scale.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiamDotPro/Docxcelerate.git"
  },
  "homepage": "https://docxcelerate.com",
  "bugs": {
    "url": "https://github.com/LiamDotPro/Docxcelerate/issues"
  },
  "keywords": [
    "docx",
    "docx-generator",
    "document-generation",
    "report-generation",
    "ooxml",
    "office",
    "word",
    "word-document",
    "documents",
    "letters",
    "templates",
    "jsx",
    "react",
    "typescript",
    "cli",
    "nodejs"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dxcl": "bin/dxcl.mjs"
  },
  "files": [
    "bin/dxcl.mjs",
    "dist/",
    "registry/",
    "templates/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./cli": {
      "types": "./dist/project/scaffold_cli.d.ts",
      "default": "./dist/project/scaffold_cli.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./docx": {
      "types": "./dist/render/docx_document.d.ts",
      "default": "./dist/render/docx_document.js"
    },
    "./preview": {
      "types": "./dist/render/docx_preview.d.ts",
      "default": "./dist/render/docx_preview.js"
    },
    "./registry": {
      "types": "./dist/registry/mod.d.ts",
      "default": "./dist/registry/mod.js"
    },
    "./registry/install": {
      "types": "./dist/registry/install.d.ts",
      "default": "./dist/registry/install.js"
    },
    "./scaffold": {
      "types": "./dist/project/scaffold.d.ts",
      "default": "./dist/project/scaffold.js"
    },
    "./template": {
      "types": "./dist/template.d.ts",
      "default": "./dist/template.js"
    },
    "./template/jsx-dev-runtime": {
      "types": "./dist/template/jsx-dev-runtime.d.ts",
      "default": "./dist/template/jsx-dev-runtime.js"
    },
    "./template/jsx-runtime": {
      "types": "./dist/template/jsx-runtime.d.ts",
      "default": "./dist/template/jsx-runtime.js"
    },
    "./themes": {
      "types": "./dist/theme/mod.d.ts",
      "default": "./dist/theme/mod.js"
    },
    "./transform": {
      "types": "./dist/transform/mod.d.ts",
      "default": "./dist/transform/mod.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run clean && npm run build && tsc -p tsconfig.test.json && node --test \"dist-tests/**/*.test.js\"",
    "clean": "node -e \"for (const d of ['dist','dist-tests']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "deno lint",
    "typecheck": "npm run build && tsc -p tsconfig.json && tsc -p tsconfig.templates.json",
    "jsr:doc": "node scripts/jsr-doc-check.mjs",
    "launch": "node scripts/submit.mjs",
    "launch:check": "node scripts/submit.mjs check",
    "dxcl": "node ./bin/dxcl.mjs",
    "templates": "tsc -p tsconfig.templates.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "docx-preview": "^0.3.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "docx": "^9.6.1"
  },
  "peerDependencies": {
    "typescript": ">=5.4"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
