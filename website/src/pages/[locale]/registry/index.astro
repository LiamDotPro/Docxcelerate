---
// The registry in every language except English, which sits at /registry/.
// Registry reads the language off the URL, so this route only has to say which
// prefixes exist.
import Registry from "../../../components/Registry.astro";
import { PREFIXED_LOCALES } from "../../../i18n";

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale } }));
}
---

<Registry />
