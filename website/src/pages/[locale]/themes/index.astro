---
// The theme gallery in every language except English, which sits at /themes/.
// ThemeGallery reads the language off the URL, so this route only has to say
// which prefixes exist.
import ThemeGallery from "../../../components/ThemeGallery.astro";
import { PREFIXED_LOCALES } from "../../../i18n";

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale } }));
}
---

<ThemeGallery />
