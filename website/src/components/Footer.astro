---
import { GITHUB_URL, NPM_URL, CLOUD_URL } from "../site";
import { asLocale, fill, localizePath, ui } from "../i18n";

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p class="m-0">
      {t.footer.licence}
    </p>
    <nav aria-label={t.footer.label} class="flex gap-5">
      <a
        href={localizePath("/docs/start-here/", locale)}
        class="no-underline text-muted hover:text-accent">{t.footer.docs}</a
      >
      <a href={CLOUD_URL} target="_blank" rel="noopener noreferrer" class="no-underline text-muted hover:text-accent">{t.footer.cloud} ↗</a>
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="no-underline text-muted hover:text-accent">{t.footer.github} ↗</a>
      <a href={NPM_URL} target="_blank" rel="noopener noreferrer" class="no-underline text-muted hover:text-accent">{t.footer.npm} ↗</a>
    </nav>
  </div>
  <div class="mx-auto max-w-6xl px-5 pb-8 text-xs text-muted sm:px-8">
    <p class="m-0">{fill(t.footer.copyright, { year })}</p>
  </div>
</footer>
