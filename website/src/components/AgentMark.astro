---
/**
 * The small mark beside an agent's name on the skill picker.
 *
 * Monochrome and drawn in `currentColor`, so a row of four sits at the same
 * weight as the words next to it and follows the tab from muted to accent when
 * it is pressed. Four brand colours in a row would turn a quiet control into a
 * sponsor board.
 *
 * Each is a plain identifying glyph rather than a traced logo — enough to tell
 * four tabs apart at 14 pixels, which is the whole job. The name beside it is
 * what actually names the agent, so every mark is `aria-hidden`.
 */
interface Props {
  agent: "claude-code" | "cursor" | "copilot" | "agents-md";
}

const { agent } = Astro.props;
---

{
  /* Claude: a burst of spokes. */
  agent === "claude-code" && (
    <svg
      viewBox="0 0 24 24"
      class="size-3.5 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M12 9V3M12 15v6M15 12h6M9 12H3M14.12 9.88l4.24-4.24M9.88 14.12l-4.24 4.24M14.12 14.12l4.24 4.24M9.88 9.88 5.64 5.64" />
    </svg>
  )
}

{
  /* Cursor: an isometric cube. */
  agent === "cursor" && (
    <svg
      viewBox="0 0 24 24"
      class="size-3.5 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 2.5 20.2 7.25v9.5L12 21.5 3.8 16.75v-9.5Z" />
      <path d="M12 21.5V12M12 12l8.2-4.75M12 12 3.8 7.25" />
    </svg>
  )
}

{
  /* Copilot: GitHub's mark, since that is whose it is. Same path the nav uses. */
  agent === "copilot" && (
    <svg viewBox="0 0 16 16" class="size-3.5 shrink-0" fill="currentColor" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
    </svg>
  )
}

{
  /* AGENTS.md: a file, because the tab is named after one. */
  agent === "agents-md" && (
    <svg
      viewBox="0 0 24 24"
      class="size-3.5 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M13.5 2.5H7A1.5 1.5 0 0 0 5.5 4v16A1.5 1.5 0 0 0 7 21.5h10a1.5 1.5 0 0 0 1.5-1.5V7.5Z" />
      <path d="M13.5 2.5v5h5" />
    </svg>
  )
}
