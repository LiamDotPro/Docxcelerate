---
/**
 * A command, with a button that copies it.
 *
 * The install command is the call to action on every registry surface, so it is
 * a control rather than a line of prose you have to select by hand.
 *
 * Drawn from the design system's CopyField: a hairline field on `--surface`, a
 * muted `$` prompt, the command in ink, and a **borderless** button. The button
 * carries no chrome of its own because the field already is the control — a
 * bordered button inside a bordered field reads as two things.
 *
 * The copy itself is progressive: the markup is a readable `<code>` on its own,
 * and the script upgrades it. Without JavaScript you still see the command and
 * can select it.
 */
interface Props {
  /** The command to show and copy. */
  command: string;
  /** Tighter, for a card footer rather than a page header. */
  compact?: boolean;
  /** What the button says once it has copied. */
  copiedLabel?: string;
  /** Extra classes, so a caller can set the width the board gives it. */
  class?: string;
}

const {
  command,
  compact = false,
  copiedLabel = "Copied",
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "flex items-center gap-3 rounded border border-default bg-surface font-mono",
    // A phone needs a 44px target; a desktop card does not, and 44px there
    // would make the field taller than the type inside it.
    "min-h-[44px] sm:min-h-0",
    compact ? "px-3 py-2" : "px-4 py-2",
    className,
  ]}
  data-copy-field
>
  <span class="select-none text-muted" aria-hidden="true">$</span>
  <code
    class:list={[
      "flex-1 select-all truncate text-ink",
      compact ? "text-[0.68rem]" : "text-sm",
    ]}
    data-copy-command>{command}</code>
  <button
    type="button"
    class:list={[
      "shrink-0 rounded-sm border-0 bg-transparent px-1.5 py-0.5 transition-colors",
      "min-h-[44px] sm:min-h-0",
      compact ? "text-[0.66rem] text-accent hover:text-accent-deep" : "text-xs text-muted hover:text-ink",
    ]}
    data-copy-button
    data-copied={copiedLabel}
    aria-label={`Copy ${command}`}
    hidden
  >
    Copy
  </button>
</div>

<script>
  for (const field of document.querySelectorAll<HTMLElement>("[data-copy-field]")) {
    const button = field.querySelector<HTMLButtonElement>("[data-copy-button]");
    const code = field.querySelector<HTMLElement>("[data-copy-command]");

    // Only offered where it can actually work. A button that does nothing is
    // worse than no button.
    if (!button || !code || !navigator.clipboard) continue;

    button.hidden = false;
    const idle = button.textContent ?? "Copy";

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.textContent = button.dataset.copied ?? "Copied";
        setTimeout(() => (button.textContent = idle), 1600);
      } catch {
        // Denied permission, or an insecure origin. The command is still on
        // screen and selectable, so there is nothing to report.
      }
    });
  }
</script>
