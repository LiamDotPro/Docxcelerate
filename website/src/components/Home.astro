---
/**
 * The homepage, in whatever language the URL asks for.
 *
 * Lives here rather than in src/pages so that `/` and `/[locale]/` are two
 * addresses for one page instead of two copies of it. Everything it says comes
 * from the dictionaries; the English left below is document content — code and
 * the sentences on the drawn pages — which stays English in every language for
 * the same reason the demo documents do.
 *
 * Laid out to the redesign's board 3a: the document itself is the hero, the
 * split preview sits under it, and everything below the fold runs on an
 * editorial grid with a § number in a left gutter.
 */
import { existsSync } from "node:fs";
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import CopyField from "./CopyField.astro";
import HeroDemo from "./HeroDemo.astro";
import { OPEN_DOCUMENT_ID } from "../demo";
import RegistryMark from "./RegistryMark.astro";
import { CLOUD_URL, GITHUB_URL, INSTALL_COMMAND, JSR_URL, NPM_URL, SITE } from "../site";
import release from "../generated/release.json";
import { asLocale, fill, localizePath, ui } from "../i18n";

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);

// Long enough to be recognisable, short enough to sit on one line; the full
// value is on the element and on the clipboard.
const shortIntegrity = `${release.integrity.slice(0, 24)}…`;

// The hero shows page one of whatever the preview below opens on. The engine
// switch only exists once an engine build of that document does — a switch
// that flips to nothing would be the hidden trick the caption says isn't there.
const heroPreview = `/demo/${OPEN_DOCUMENT_ID}.html`;
const heroEngine = `/demo/${OPEN_DOCUMENT_ID}.engine.html`;
const hasEngine = existsSync(new URL(`../../public${heroEngine}`, import.meta.url));

const structuredData = [
  {
    "@type": "SoftwareApplication",
    name: SITE.name,
    description: t.meta.description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Node.js 20+",
    softwareVersion: release.version,
    inLanguage: locale,
    url: new URL(localizePath("/", locale), Astro.site).href,
    codeRepository: GITHUB_URL,
    downloadUrl: NPM_URL,
    license: "https://opensource.org/licenses/MIT",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@type": "WebSite",
    name: SITE.name,
    url: new URL(localizePath("/", locale), Astro.site).href,
    inLanguage: locale,
  },
];

const BRIEF_CODE = `export const QuarterInBrief: Paragraph = () => {
  const [state] = useState((data: ReviewData) => ({
    client: data.client.formalName,
    adviser: data.adviser.name,
    plans: data.client.plans,
  }));

  useSetPrompts({
    systemPrompt: \`You are \${state.adviser}, a financial planner.\`,
    generalPrompt: "Explain this quarter in one short paragraph.",
    infoPrompt: \`Client plans: \${state.plans}\`,
    negativePrompt: "No forecasts. No product names.",
  });
  useSetPlaceholders(\`A letter from \${state.adviser}.\`);

  return <Paragraph id="quarter-in-brief" variant="quote" />;
};`;

const DOCUMENT_CODE = `export const documentTemplate = template<ReviewData>(
  <Document id="portfolio-review" title="Quarterly portfolio review"
    firstHeader={false} header={<RunningHeader />} footer={<RunningFooter />}>
    <Cover />
    <PageBreak />
    <Letter />
    <Summary />
    <Performance />
    <Allocation />
    <Holdings />
    <TermsNotice />
  </Document>,
);`;

// A pull request as a review tool shows it: per file, a hunk header, old and
// new line numbers, context either side, and the words that changed picked
// out within the line. A segment in [brackets] is the part that changed.
type DiffLine = { kind: " " | "-" | "+"; old?: number; new?: number; text: string };
const DIFF: { file: string; hunk: string; lines: DiffLine[] }[] = [
  {
    file: "nodes/arrears.node.tsx",
    hunk: "@@ -12,5 +12,5 @@ export const Arrears: Paragraph = () => {",
    lines: [
      { kind: " ", old: 12, new: 12, text: "  return (" },
      { kind: " ", old: 13, new: 13, text: '    <Paragraph id="arrears">' },
      { kind: "-", old: 14, text: "      Pay within [14] days of this notice." },
      { kind: "+", new: 14, text: "      Pay within [30] days of this notice." },
      { kind: " ", old: 15, new: 15, text: "    </Paragraph>" },
      { kind: " ", old: 16, new: 16, text: "  );" },
    ],
  },
  {
    file: "nodes/contact.node.tsx",
    hunk: "@@ -8,3 +8,3 @@ export const Contact: Paragraph = () => (",
    lines: [
      { kind: " ", old: 8, new: 8, text: '  <Paragraph id="contact">' },
      { kind: "-", old: 9, text: "    Call us [to discuss]." },
      { kind: "+", new: 9, text: "    Call us [to agree a payment plan]." },
      { kind: " ", old: 10, new: 10, text: "  </Paragraph>" },
    ],
  },
];
const CHECKS = ["arrears-notice renders as expected", "no other document changed"];
/** A line's text split into runs, each marked as changed or not. */
const runs = (text: string) =>
  text.split(/(\[[^\]]*\])/).filter(Boolean).map((run) =>
    run.startsWith("[") ? { text: run.slice(1, -1), changed: true } : { text: run, changed: false }
  );

// Five reviews out of one template: the figures and the decision differ per
// client, and the only generated line is the one on the wash.
const FAN = [
  { name: "Ms A. Nkemelu", value: "£412,860", decision: "Rebalance", note: "Equities are 4.2 points above target." },
  { name: "Mr R. Achterberg", value: "£96,214", decision: "Hold", note: "Within range; no trades this quarter." },
  { name: "Dr P. Raman", value: "£1,284,507", decision: "Rebalance", note: "Bonds drifted below their agreed range." },
  { name: "Mrs S. Doyle", value: "£238,940", decision: "Hold", note: "Cash kept for the house purchase in May." },
  { name: "Mr K. Asante", value: "£57,118", decision: "Hold", note: "New ISA contributions kept the mix on target." },
];

const STATIONS = [
  { ...t.home.engine.steps.build, l1: "documents/portfolio-review/build/", l2: "→ manifest.json · document.json" },
  { ...t.home.engine.steps.publish, l1: "upload → reviews.example.com/api/reviews", l2: "→ portfolio-review@6 stored" },
  { ...t.home.engine.steps.write, l1: "POST /api/reviews { client, holdings, … }", l2: "→ 200 portfolio-review.docx" },
];

const THEME_SAMPLE =
  "Your tenancy at 14 Glebe Road ends on 30 September. This letter sets out what happens next, and what we need from you before then.";

const codeThemes = { light: "github-light", dark: "github-dark-dimmed" } as const;
---

<Base bare structuredData={structuredData}>
  <!-- Hero. The ground is fixed green in both themes, so the tokens are
       re-pointed at their dark values for everything inside it. -->
  <section class="band-dark relative overflow-hidden bg-ledger-950 text-white">
    <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="relative mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-12 px-5 pt-16 sm:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:pt-22"
    >
      <div class="flex flex-col gap-6 pb-16 lg:pb-20">
        <h1
          class="m-0 text-[clamp(2.6rem,6vw,3.9rem)] leading-[1.02] font-semibold tracking-[-0.03em] text-white"
        >
          {t.home.headlineLineOne}<br /><span class="text-ledger-300">{t.home.headlineLineTwo}</span>
        </h1>
        <p class="m-0 max-w-[31rem] text-[1.15rem] leading-[1.65] text-pretty text-ledger-100">
          {t.home.lead}
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={localizePath("/docs/start-here/", locale)}
            class="rounded bg-accent-solid px-5 py-2.5 text-sm font-medium text-on-accent no-underline transition-colors hover:bg-ledger-500"
            >{t.home.ctaStart}</a
          >
          <a
            href={localizePath("/docs/generation/endpoint/", locale)}
            class="rounded border border-firm px-5 py-2.5 text-sm font-medium text-accent no-underline transition-colors hover:bg-accent-tint"
            >{t.home.ctaHowItWorks}</a
          >
        </div>

        <div class="flex max-w-full flex-col gap-3 self-start">
          <CopyField command={INSTALL_COMMAND} copiedLabel={t.home.copied} />
          <p
            class="m-0 flex flex-wrap items-center gap-x-2.5 gap-y-1 pl-0.5 font-mono text-[0.72rem] text-ledger-200"
          >
            <span data-release-version>v{release.version}</span>
            <RegistryMark registry="npm" href={NPM_URL} label={t.home.onNpm} />
            <RegistryMark registry="jsr" href={JSR_URL} label={t.home.onJsr} />
            <span aria-hidden="true">·</span>
            <button
              type="button"
              id="copy-integrity"
              data-release-integrity={release.integrity}
              data-copied={t.home.copied}
              data-fallback={t.home.copyFallback}
              class="max-w-full truncate rounded px-1 text-left tabular-nums transition-colors hover:text-white"
              title={fill(t.home.integrityTitle, { hash: release.integrity })}
            >
              {shortIntegrity}
            </button>
          </p>
        </div>

        {
          hasEngine && (
            <div class="mt-3 flex flex-col gap-3 border-t border-white/15 pt-5">
              <span class="font-mono text-[0.65rem] tracking-[0.16em] text-ledger-300 uppercase">
                {t.home.builds.label}
              </span>
              <div
                class="flex self-start overflow-hidden rounded border border-white/25"
                role="group"
                aria-label={t.home.builds.label}
              >
                <button type="button" class="mode-btn" data-hero-mode="engine" aria-pressed="true">
                  {t.home.builds.engine}
                </button>
                <button type="button" class="mode-btn" data-hero-mode="preview" aria-pressed="false">
                  {t.home.builds.preview}
                </button>
              </div>
              <p
                class="m-0 max-w-[30rem] text-[0.85rem] leading-[1.6] text-ledger-200"
                data-hero-caption
                data-engine={t.home.builds.engineCaption}
                data-preview={t.home.builds.previewCaption}
              >
                {t.home.builds.engineCaption}
              </p>
            </div>
          )
        }
      </div>

      <!-- Page one at 60%, running off the bottom of the band like a sheet
           half out of the tray. Decorative: the same page is in the preview
           below, where it can be read and scrolled. Under the copy from sm,
           beside it from lg; a phone is too narrow for a page that reads. -->
      <div class="relative -mt-8 hidden h-[26rem] sm:block lg:mt-0 lg:h-auto lg:min-h-[640px]" aria-hidden="true">
        <div class="hero-sheet absolute top-0 bottom-0 left-0">
          <iframe
            src={hasEngine ? heroEngine : heroPreview}
            data-preview={heroPreview}
            data-engine={heroEngine}
            data-hero-frame
            title=""
            tabindex="-1"
            loading="lazy"
            class="hero-frame"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- The split preview. Every band on the page sits on the nav's measure, so
       the wordmark, the hero copy and each section start on one edge. -->
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-16 sm:px-8">
    <HeroDemo />
  </section>

  <!-- §1 Source. Preview. Document. One paragraph, followed from the file to
       the page. -->
  <section class="border-b border-default">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="clause mb-14">
        <span class="clause-no">§1</span>
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-14">
          <h2 class="m-0 text-[clamp(2.2rem,4vw,3rem)] leading-[1.05] font-semibold tracking-[-0.02em]">
            {t.home.source.title}
          </h2>
          <p class="m-0 text-[1.05rem] leading-[1.7] text-pretty text-muted">{t.home.source.lead}</p>
        </div>
      </div>
      <div class="clause">
        <span aria-hidden="true"></span>
        <div
          class="grid grid-cols-[minmax(0,1fr)] overflow-hidden rounded-md border border-default lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)_minmax(0,1fr)]"
        >
          <div class="stage">
            <div class="stage-bar"><span>01 · nodes/quarter-in-brief.node.tsx</span><span>{t.home.source.sourceLabel}</span></div>
            <div class="code-figure"><Code code={BRIEF_CODE} lang="tsx" themes={codeThemes} /></div>
            <p class="stage-note">{t.home.source.sourceNote}</p>
          </div>
          <div class="stage">
            <div class="stage-bar"><span>02 · dxcl dev</span><span>{t.home.source.previewLabel}</span></div>
            <div class="stage-body workspace">
              <div class="sheet">
                <p class="letter m-0 text-[#657287]">
                  A letter from Tomas Lindqvist on this quarter, from the figures and Ms Nkemelu's plans.
                </p>
              </div>
            </div>
            <p class="stage-note">{t.home.source.previewNote}</p>
          </div>
          <div class="stage">
            <div class="stage-bar"><span>03 · engine</span><span class="text-accent">200 · .docx</span></div>
            <div class="stage-body workspace">
              <div class="sheet">
                <p class="letter m-0">
                  <span class="wash">Your portfolio grew by £11,942 this quarter, to £412,860, and finished ahead of its benchmark — mostly because global and emerging-market shares had a strong August.</span>
                </p>
              </div>
            </div>
            <p class="stage-note">{t.home.source.engineNote}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- §2 and §3, the two claims about how documents are written and kept. -->
  <section class="border-b border-default bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="clause clause-3 border-b border-default pb-16">
        <span class="clause-no">§2</span>
        <div class="flex flex-col gap-4 lg:pr-8">
          <span class="eyebrow">{t.home.points.authoring.label}</span>
          <h2 class="m-0 text-[2.4rem] leading-[1.1] font-semibold">{t.home.points.authoring.title}</h2>
          <p class="m-0 leading-[1.75] text-pretty text-muted">{t.home.points.authoring.body}</p>
        </div>
        <div class="flex min-w-0 flex-col overflow-hidden rounded-md border border-default">
          <div class="stage-bar"><span>documents/portfolio-review/document.tsx</span></div>
          <div class="code-figure"><Code code={DOCUMENT_CODE} lang="tsx" themes={codeThemes} /></div>
        </div>
      </div>
      <div class="clause clause-3 pt-16">
        <span class="clause-no">§3</span>
        <div class="flex flex-col gap-4 lg:pr-8">
          <span class="eyebrow">{t.home.points.changeControl.label}</span>
          <h2 class="m-0 text-[2.4rem] leading-[1.1] font-semibold">{t.home.points.changeControl.title}</h2>
          <p class="m-0 leading-[1.75] text-pretty text-muted">{t.home.points.changeControl.body}</p>
        </div>
        <div class="diff min-w-0 overflow-hidden rounded-md border border-default">
          <div class="stage-bar">
            <span>arrears-wording → main</span><span>2 files changed</span>
          </div>
          {
            DIFF.map((file) => (
              <div class="diff-file">
                <div class="diff-file-bar">
                  <span class="diff-badge" aria-hidden="true">M</span>
                  <span class="min-w-0 truncate text-ink">{file.file}</span>
                  <span class="ml-auto shrink-0">
                    <span class="text-accent">+{file.lines.filter((line) => line.kind === "+").length}</span>{" "}
                    <span class="text-rubric">−{file.lines.filter((line) => line.kind === "-").length}</span>
                  </span>
                </div>
                <div class="diff-body">
                  <div class="diff-hunk">{file.hunk}</div>
                  {file.lines.map((line) => (
                    <div class:list={["diff-line", line.kind === "-" && "diff-del", line.kind === "+" && "diff-ins"]}>
                      <span class="diff-no">{line.old ?? ""}</span>
                      <span class="diff-no">{line.new ?? ""}</span>
                      <span class="diff-sign">{line.kind === " " ? "" : line.kind === "-" ? "−" : "+"}</span>
                      <span class="diff-text">
                        {runs(line.text).map((run) => (run.changed ? <mark>{run.text}</mark> : run.text))}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
          <div class="diff-checks">
            {CHECKS.map((check) => <div><span class="diff-pass" aria-hidden="true">✓</span> {check}</div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The thesis, said by the person who wrote the thing. Fixed green, like
       the hero and the footer. -->
  <section class="relative overflow-hidden bg-ledger-900 text-white">
    <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 py-24 text-center sm:px-8 sm:py-32">
      <p class="pull-quote">{t.home.pullQuote}</p>
      <figure class="m-0 mt-10 flex flex-col items-center gap-3">
        <div class="rounded-full bg-white/10 p-1 shadow-[0_10px_30px_rgba(0,0,0,0.25)]">
          <img
            src="/liam.webp"
            width="208"
            height="208"
            loading="lazy"
            decoding="async"
            alt={t.home.attribution.portraitAlt}
            class="h-26 w-26 rounded-full object-cover"
          />
        </div>
        <figcaption class="font-mono text-[0.62rem] leading-[1.7] tracking-[0.14em] text-white/60 uppercase">
          {t.home.attribution.name}<br /><span class="text-white/45">{t.home.attribution.role}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- §4 The engine: one template fanned out into five clients' reviews,
       then the three stations a document passes through. -->
  <section class="border-b border-default">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="clause clause-3">
        <span class="clause-no">§4</span>
        <div class="flex flex-col gap-4 lg:pr-8">
          <span class="eyebrow">{t.home.engine.eyebrow}</span>
          <h2 class="m-0 text-[clamp(2.2rem,4vw,3rem)] leading-[1.05] font-semibold tracking-[-0.02em]">
            {t.home.engine.title}
          </h2>
          <p class="m-0 leading-[1.75] text-pretty text-muted">{t.home.engine.bodyTwo}</p>
          <div class="mt-2 flex flex-wrap gap-3">
            <a
              href={localizePath("/docs/generation/endpoint/", locale)}
              class="rounded bg-accent-solid px-5 py-2.5 text-sm font-medium text-on-accent no-underline transition-colors hover:bg-accent-deep"
              >{t.home.engine.ctaHow}</a
            >
            <a
              href={CLOUD_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded border border-firm px-5 py-2.5 text-sm font-medium text-muted no-underline transition-colors hover:text-accent"
              >{t.home.engine.ctaCloud}
              <span class="rounded-full border border-firm px-1.5 py-px font-mono text-[0.6rem] tracking-[0.08em] uppercase"
                >{t.common.soon}</span
              ></a
            >
          </div>
        </div>
        <div class="flex min-w-0 flex-col justify-end gap-5" aria-hidden="true">
          <div class="fan">
            {
              FAN.map((review) => (
                <div class="fan-page">
                  <div class="fan-cover">
                    <span class="fan-title">Third quarter 2026</span>
                    <span class="fan-name">{review.name}</span>
                    <span class="fan-value">{review.value}</span>
                  </div>
                  <div class="h-0.5 bg-ledger-500"></div>
                  <div class="flex flex-col gap-1.5 px-3 py-2.5">
                    <span class:list={["fan-stamp", review.decision === "Hold" && "fan-stamp-hold"]}>
                      {review.decision}
                    </span>
                    <span class="fan-note"><span class="wash">{review.note}</span></span>
                  </div>
                </div>
              ))
            }
          </div>
          <div
            class="flex flex-wrap justify-between gap-2 border-t border-default pt-3 font-mono text-[0.72rem] text-muted"
          >
            <span>POST /api/reviews · portfolio-review@6</span>
            <span class="text-ink">{fill(t.home.engine.volume, { count: "3,180" })}</span>
          </div>
        </div>
      </div>
      <div class="clause mt-18">
        <span aria-hidden="true"></span>
        <ol class="m-0 grid list-none grid-cols-[minmax(0,1fr)] gap-8 p-0 md:grid-cols-3">
          {
            STATIONS.map((station, index) => (
              <li class="m-0 flex flex-col gap-2.5 border-t-2 border-ink pt-4">
                <div class="flex items-baseline justify-between">
                  <h3 class="m-0 text-[1.4rem] font-semibold">{station.title}</h3>
                  <span class="font-mono text-[0.7rem] text-muted">{String(index + 1).padStart(2, "0")}</span>
                </div>
                <p class="m-0 text-[0.92rem] leading-[1.65] text-muted">{station.detail}</p>
                <div
                  class="mt-1.5 overflow-x-auto rounded border border-default bg-surface px-3.5 py-3 font-mono text-[0.7rem] leading-[1.75] whitespace-nowrap text-muted"
                >
                  <div>{station.l1}</div>
                  <div class="text-accent">{station.l2}</div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- §5 The registry: what installing writes, and three themes as the paper
       they produce. -->
  <section class="bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="clause clause-3 lg:items-center">
        <span class="clause-no lg:self-start">§5</span>
        <div class="flex flex-col gap-4 lg:pr-8">
          <span class="eyebrow">{t.nav.registry}</span>
          <h2 class="m-0 text-[2.4rem] leading-[1.1] font-semibold">{t.registry.ad.heading}</h2>
          <p class="m-0 leading-[1.75] text-pretty text-muted">{t.registry.ad.body}</p>
          <div class="mt-2 overflow-x-auto rounded-md bg-ledger-950 px-4.5 py-4 font-mono text-[0.76rem] leading-[1.85] whitespace-nowrap text-[#d7e0da]">
            <div><span class="text-ledger-300">$</span> npx dxcl add slate-report letterhead</div>
            <div class="text-[#93a29a]">+ document-style.ts ← slate-report</div>
            <div class="text-[#93a29a]">+ nodes/letterhead.node.tsx</div>
            <div class="text-ledger-300">✓ {t.registry.ad.written}</div>
          </div>
          <a href={localizePath("/registry/", locale)} class="text-[0.9rem] font-medium no-underline hover:underline"
            >{t.registry.ad.browse} →</a
          >
        </div>
        <div class="workspace flex items-end justify-center gap-5 rounded-md px-4 py-10" aria-hidden="true">
          <div class="theme-sheet gap-[7px] px-5 py-[22px]">
            <span class="font-[Cambria,Georgia,serif] text-[13px] font-bold">Membership renewal</span>
            <span class="font-[Aptos,'Segoe_UI',Arial,sans-serif] text-[7.5px] leading-normal">{THEME_SAMPLE}</span>
            <span class="theme-name">clean-minimal</span>
          </div>
