---
/**
 * The homepage, in whatever language the URL asks for.
 *
 * Lives here rather than in src/pages so that `/` and `/[locale]/` are two
 * addresses for one page instead of two copies of it. Everything it says comes
 * from the dictionaries; the only English left below is markup.
 */
import AgentSkill from "./AgentSkill.astro";
import Base from "../layouts/Base.astro";
import EngineFigure from "./EngineFigure.astro";
import HeroDemo from "./HeroDemo.astro";
import LicenceSheet from "./LicenceSheet.astro";
import PointFigure from "./PointFigure.astro";
import RegistryMark from "./RegistryMark.astro";
import { COMPONENTS as REGISTRY_COMPONENTS, THEMES as REGISTRY_THEMES } from "../registry";
import ScaleFigure from "./ScaleFigure.astro";
import {
  CLOUD_URL,
  GITHUB_URL,
  INSTALL_COMMAND,
  JSR_URL,
  NPM_LATEST_URL,
  NPM_URL,
  SITE,
} from "../site";
import release from "../generated/release.json";
import { asLocale, fill, localizePath, ui } from "../i18n";

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);

// Long enough to be recognisable, short enough to sit on one line; the full
// value is on the element and on the clipboard.
const shortIntegrity = `${release.integrity.slice(0, 24)}…`;

// The label names the dimension each point argues on, so the three read as a
// set covering authoring, AI and governance rather than three loose claims.
// `figure` picks the drawing that sits under the heading — see PointFigure.
const POINTS = [
  { ...t.home.points.authoring, figure: "authoring" as const },
  { ...t.home.points.ai, figure: "ai" as const },
  { ...t.home.points.changeControl, figure: "changeControl" as const },
];

// A real sequence, so it's numbered. The first step is the only one the
// framework is responsible for.
const STEPS = [
  { ...t.home.engine.steps.build, figure: "build" as const },
  { ...t.home.engine.steps.publish, figure: "publish" as const },
  { ...t.home.engine.steps.write, figure: "write" as const },
];

// Volume first, because it is the claim the section is making; the other three
// are what makes volume survivable once you have it.
const TRAITS = [
  { ...t.home.scale.traits.volume, figure: "volume" as const },
  { ...t.home.scale.traits.determinism, figure: "determinism" as const },
  { ...t.home.scale.traits.integration, figure: "integration" as const },
  { ...t.home.scale.traits.reproducibility, figure: "reproducibility" as const },
];

// What the package is, in the vocabulary a search engine already has. The
// version and licence come from the release the site was built against, so this
// cannot drift from the install command printed above it.
const structuredData = [
  {
    "@type": "SoftwareApplication",
    name: SITE.name,
    description: t.meta.description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Node.js 20+",
    softwareVersion: release.version,
    inLanguage: locale,
    url: new URL(localizePath("/", locale), Astro.site).href,
    codeRepository: GITHUB_URL,
    downloadUrl: NPM_URL,
    license: "https://opensource.org/licenses/MIT",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@type": "WebSite",
    name: SITE.name,
    url: new URL(localizePath("/", locale), Astro.site).href,
    inLanguage: locale,
  },
];

const CARDS = [
  { ...t.home.docs.cards.startHere, href: "/docs/start-here/" },
  { ...t.home.docs.cards.documentsAndNodes, href: "/docs/essentials/documents-and-nodes/" },
  { ...t.home.docs.cards.nodeModel, href: "/docs/nodes/overview/" },
  { ...t.home.docs.cards.writingNodes, href: "/docs/writing-nodes/" },
  { ...t.home.docs.cards.cli, href: "/docs/cli/commands/" },
  { ...t.home.docs.cards.entrypoints, href: "/docs/reference/entrypoints/" },
];
---

<Base bare structuredData={structuredData}>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-12 pb-10 sm:px-8 sm:pt-16">
    <div class="flex flex-col items-center gap-6 text-center">
      <h1
        class="m-0 max-w-3xl text-[clamp(2.6rem,7vw,4.5rem)] font-semibold leading-[1.02]"
      >
        {t.home.headlineLineOne}<br />{t.home.headlineLineTwo}
      </h1>
      <p class="m-0 max-w-xl text-lg leading-relaxed text-muted">
        {t.home.lead}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={localizePath("/docs/start-here/", locale)}
          class="rounded bg-accent-solid px-5 py-2.5 text-sm font-medium text-on-accent no-underline transition-colors hover:bg-accent-deep"
          >{t.home.ctaStart}</a
        >
        <a
          href={localizePath("/docs/generation/endpoint/", locale)}
          class="rounded border border-border-firm px-5 py-2.5 text-sm font-medium text-accent no-underline transition-colors hover:bg-accent-tint"
          >{t.home.ctaHowItWorks}</a
        >
      </div>

      <div
        class="mt-1 flex items-center gap-3 rounded border border-border bg-surface px-4 py-2 font-mono text-sm"
      >
        <span class="select-none text-muted">$</span>
        <code id="install-cmd">{INSTALL_COMMAND}</code>
        <button
          type="button"
          id="copy-install"
          class="ml-1 rounded px-1.5 py-0.5 text-xs text-muted transition-colors hover:text-accent"
          data-idle={t.home.copy}
          data-copied={t.home.copied}
          data-fallback={t.home.copyFallback}
          aria-label={t.home.copyInstall}>{t.home.copy}</button
        >
      </div>

      <p
        class="m-0 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 font-mono text-[0.68rem] text-muted"
      >
        <span id="release-version" data-latest={NPM_LATEST_URL}>v{release.version}</span>
        <RegistryMark registry="npm" href={NPM_URL} label={t.home.onNpm} />
        <RegistryMark registry="jsr" href={JSR_URL} label={t.home.onJsr} />
        <span aria-hidden="true">·</span>
        <button
          type="button"
          id="copy-integrity"
          data-integrity={release.integrity}
          data-copied={t.home.copied}
          data-fallback={t.home.copyFallback}
          class="max-w-full truncate rounded px-1 text-left tabular-nums transition-colors hover:text-accent"
          title={fill(t.home.integrityTitle, { hash: release.integrity })}
        >
          {shortIntegrity}
        </button>
      </p>
    </div>

  </section>

  <!-- The demo runs wider than the prose above it — it is the argument, not an
       illustration of one. It takes the page measure to do it: the hero copy is
       held to max-w-3xl and max-w-xl inside the same band, so the demo is still
       far the widest thing here without leaving the edge the nav sets. -->
  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8">
    <HeroDemo />
  </section>

  <!-- The thesis, said by the person who wrote the thing, on the first of the
       page's two full bands of green — this one for what the toolkit is for,
       the registry band further down for what it hands you. The green is fixed
       rather than tokenised: like the letter preview, it is the same in both
       themes. Top margin only — the band owns the gap after it. -->
  <section class="relative mt-10 overflow-hidden bg-ledger-900 text-white sm:mt-6">
    <div
      class="pointer-events-none absolute inset-0"
      style="background:radial-gradient(ellipse 70% 90% at 50% 34%, rgba(159,212,184,0.16), rgba(15,63,45,0) 70%)"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-3xl px-5 py-24 text-center sm:px-8 sm:py-32">
      <p class="pull-quote">
        {t.home.pullQuote}
      </p>
      <figure class="m-0 mt-10 flex flex-col items-center gap-3">
        <div class="rounded-full bg-white/10 p-1 shadow-[0_10px_30px_rgba(0,0,0,0.25)]">
          <img
            src="/liam.webp"
            width="208"
            height="208"
            loading="lazy"
            decoding="async"
            alt={t.home.attribution.portraitAlt}
            class="h-26 w-26 rounded-full object-cover"
          />
        </div>
        <figcaption
          class="font-mono text-[0.62rem] leading-[1.7] tracking-[0.14em] text-white/60 uppercase"
        >
          {t.home.attribution.name}<br /><span class="text-white/45"
            >{t.home.attribution.role}</span
          >
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Positioning. Each point leads with a drawing of the claim it makes.
       The three columns share one set of row tracks, so label, drawing,
       heading and prose each start on the same line across all three however
       long a translated title runs. -->
  <section class="border-b border-border">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="grid gap-16 xl:grid-cols-3 xl:gap-0">
        {
          POINTS.map((point, index) => (
            <div
              class:list={[
                // min-w-0 so the code figure scrolls inside its column
                // instead of stretching the column to fit its longest line.
                "flex min-w-0 flex-col",
                // Side by side, each column takes the row tracks of the grid
                // above it rather than stacking its own four items: the four
                // rows then size to the tallest label, drawing, heading and
                // paragraph, and every column's prose starts on the same line
                // even where a title runs to one line and its neighbours run
                // to two. Nothing here is a measured reservation, so a longer
                // translation moves the line rather than breaking it.
                "xl:row-span-4 xl:grid xl:grid-rows-subgrid",
                // Three up from xl, later than the rest of the page, because
                // these columns carry code rather than prose: under about
                // 1280 a third of the row is too narrow for the longest line,
                // so the figures wrap to different heights, the headings stop
                // lining up and the narrowest column scrolls. Stacked, each
                // figure gets the full measure and none of them scroll.
                //
                // The band sits on the page measure, not a wider one, so it
                // starts on the same edge as the nav and the engine section
                // below it. That costs the columns width, and the middle one —
                // padded on both sides — is the one it comes off: the gutters
                // are 8 rather than 11 to buy some of it back. It leaves the
                // narrowest figure column around 20px clear of the longest
                // line in PointFigure. Widen the gutters and that line scrolls.
                //
                // Hairlines between columns rather than boxes around them —
                // the points are peers, not cards.
                index > 0 && "xl:border-l xl:border-border xl:pl-8",
                index < POINTS.length - 1 && "xl:pr-8",
              ]}
            >
              <span class="mb-4 font-mono text-[0.65rem] font-medium uppercase tracking-[0.16em] text-accent tabular-nums">
                {String(index + 1).padStart(2, "0")}
                <span class="mx-2 text-muted" aria-hidden="true">
                  ·
                </span>
                {point.label}
              </span>
              <PointFigure kind={point.figure} />
              <!-- The heading and its prose read as one block now the drawing
                   is above them rather than between them, so the gap between
                   the two closes to match. The measure is in the heading's own
                   ems: it breaks every title over two lines rather than
                   letting one column run wide and short beside two that wrap,
                   and balancing gives two lines of a length instead of a long
                   one over a stub. 11em is wide enough that every locale
                   settles on two lines and narrow enough that the shortest
                   English title cannot creep back onto one. A title that needs
                   a third line still gets one — the row grows and all three
                   paragraphs move down together. -->
              <h2 class="m-0 mb-3 max-w-[11em] text-[1.75rem] leading-[1.15] font-semibold text-balance">
                {point.title}
              </h2>
              <p class="m-0 text-[0.975rem] leading-[1.75] text-pretty text-muted">
                {point.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The engine. The steps run down a spine on the right, each carrying the
       artefact it actually produces. -->
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
      <div class="grid gap-12 md:grid-cols-2 md:gap-16">
        <div class="flex max-w-xl flex-col gap-5">
          <span
            class="font-mono text-[0.65rem] font-medium uppercase tracking-[0.16em] text-accent"
            >{t.home.engine.eyebrow}</span
          >
          <h2 class="m-0 text-3xl font-semibold sm:text-4xl">{t.home.engine.title}</h2>
          <p class="m-0 leading-relaxed text-muted">
            {t.home.engine.bodyOne}
          </p>
          <p class="m-0 leading-relaxed text-muted">
            {t.home.engine.bodyTwo}
          </p>
          <div class="mt-2 flex flex-wrap gap-3">
            <a
              href={localizePath("/docs/generation/endpoint/", locale)}
              class="rounded bg-accent-solid px-5 py-2.5 text-sm font-medium text-on-accent no-underline transition-colors hover:bg-accent-deep"
              >{t.home.engine.ctaHow}</a
            >
            <a
              href={CLOUD_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded border border-border-firm px-5 py-2.5 text-sm font-medium text-muted no-underline transition-colors hover:text-accent"
              >{t.home.engine.ctaCloud}
              <span
                class="rounded-full border border-border-firm px-1.5 py-px font-mono text-[0.6rem] uppercase tracking-[0.08em]"
                >{t.common.soon}</span
              ></a
            >
          </div>
        </div>

        <!-- A spine rather than a ruled list: the numbers are joined because the
             three steps are one sequence, and the rule between them is the
             thing that says so. -->
        <ol class="m-0 flex list-none flex-col p-0">
          {
            STEPS.map((step, index) => (
              <li class="m-0 grid grid-cols-[3.25rem_1fr]">
                <div class="flex flex-col items-center">
                  <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-accent-solid font-mono text-[0.62rem] text-on-accent tabular-nums">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {index < STEPS.length - 1 && (
                    <span class="my-2 w-px flex-1 bg-border-firm" aria-hidden="true" />
                  )}
                </div>
                <div class:list={["min-w-0", index < STEPS.length - 1 && "pb-8"]}>
                  <h3 class="m-0 text-xl font-semibold">{step.title}</h3>
                  <p class="mt-1.5 mb-3.5 text-sm leading-relaxed text-pretty text-muted">
                    {step.detail}
                  </p>
                  <EngineFigure kind={step.figure} />
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Themes and components. Sits mid-page on purpose: by here a reader has
       been told what the toolkit is and how a document reaches an engine, and
       the next honest question is how much of this they have to write
       themselves.

       The panel beside the copy is the argument. "No dependency" is a claim
       until you see what installing actually does, and what it does is write
       two files and stop — so the band shows the command and its output rather
       than describing them.

       On the green, because this is the page's offer rather than another of
       its explanations, and a band that changes ground is one a reader stops
       at. The colours here are fixed for the same reason the thesis band's
       are: the ground is the green in both themes, so what sits on it is
       written against the green rather than against a token that moves. -->
  <section class="bg-ledger-900 text-white">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="flex max-w-xl flex-col gap-5">
          <h2 class="m-0 text-3xl font-semibold sm:text-4xl">{t.registry.ad.heading}</h2>
          <p class="m-0 leading-relaxed text-white/70">{t.registry.ad.body}</p>
          <div class="flex flex-wrap gap-3">
            <!-- The call to action reverses out: on the green a solid green
                 button is a button nobody sees. -->
            <a
              href={localizePath("/registry/", locale)}
              class="rounded bg-white px-5 py-2.5 text-sm font-medium text-ledger-900 no-underline transition-colors hover:bg-ledger-50"
              >{t.registry.ad.browse} →</a
            >
            <a
              href={localizePath("/docs/document-projects/", locale)}
              class="rounded border border-white/35 px-5 py-2.5 text-sm font-medium text-white no-underline transition-colors hover:bg-white/10"
              >{t.registry.ad.howItWorks}</a
            >
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <!-- What the command writes, as it writes it. The file names are
               real: they are what dxcl add puts in a project. -->
          <div class="overflow-hidden rounded-lg border border-white/15 bg-ledger-950">
            <div class="border-b border-white/10 bg-white/5 px-3 py-2">
              <span class="font-mono text-[0.7rem] text-white/55">your-project — dxcl</span>
            </div>
            <div class="flex flex-col gap-1 p-4 font-mono text-[0.78rem] leading-relaxed">
              <div class="text-white/85">
                <span class="text-white/50">$ </span>npx dxcl add slate-report letterhead
              </div>
              <!-- The marks stay the palette's own green, which is the one
                   colour on this ground that is still a colour rather than a
                   shade of the ground. -->
              <div class="text-white/85">
                <span class="text-ledger-300">+</span> document-style.ts
                <span class="text-white/50">← slate-report</span>
              </div>
              <div class="text-white/85">
                <span class="text-ledger-300">+</span> nodes/letterhead.node.tsx
              </div>
              <div class="pl-4 text-white/50">re-exported from nodes/index.ts</div>
              <div class="mt-1 text-white/50">
                <span class="text-ledger-300">✓</span> {t.registry.ad.written}
              </div>
            </div>
          </div>
          <span class="text-xs leading-relaxed text-white/55">{t.registry.ad.afterInstall}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Scale. Cards rather than columns: the first claim is the section's
       argument and gets the width, and the three under it are what makes the
       first survivable. -->
  <section>
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
      <div class="mb-12 flex max-w-2xl flex-col gap-4">
        <span
          class="font-mono text-[0.65rem] font-medium uppercase tracking-[0.16em] text-accent"
          >{t.home.scale.eyebrow}</span
        >
        <h2 class="m-0 text-3xl font-semibold sm:text-4xl">{t.home.scale.title}</h2>
        <p class="m-0 leading-relaxed text-muted">
          {t.home.scale.lead}
        </p>
      </div>

      <!-- Numbered but unordered: they are four properties of one design, not
           steps, and the numerals only give the eye somewhere to land. The
           first runs the full width and sets its drawing beside the words;
           the rest stack theirs underneath. -->
      <div class="grid gap-5 lg:grid-cols-3">
        {
          TRAITS.map((trait, index) => (
            <div
              class:list={[
                "flex min-w-0 flex-col rounded-md border border-border p-7",
                index === 0 && "gap-8 lg:col-span-3 lg:grid lg:grid-cols-2 lg:items-center lg:gap-14",
              ]}
            >
              <div class="flex flex-col">
                <span class="mb-3 font-mono text-[0.7rem] text-muted tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="m-0 mb-2 text-lg font-semibold">{trait.title}</h3>
                <p class="m-0 text-[0.95rem] leading-[1.75] text-pretty text-muted">{trait.body}</p>
              </div>
              <div class:list={[index > 0 && "mt-auto pt-7"]}>
                <ScaleFigure kind={trait.figure} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Open source. The claim is a licence, so the licence is the picture: a
       fixed track for the sheet, because a sheet of paper is not elastic. -->
  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
      <div class="grid gap-14 lg:grid-cols-[1fr_420px] lg:items-start lg:gap-16">
        <div class="flex max-w-xl flex-col gap-5">
          <span
            class="font-mono text-[0.65rem] font-medium uppercase tracking-[0.16em] text-accent"
            >{t.home.openSource.eyebrow}</span
          >
          <h2 class="m-0 text-3xl font-semibold sm:text-4xl">{t.home.openSource.title}</h2>
          <p class="m-0 leading-relaxed text-pretty text-muted">
            {t.home.openSource.bodyOne}
          </p>
          <p class="m-0 leading-relaxed text-pretty text-muted">
            {t.home.openSource.bodyTwo}
          </p>
          <div class="mt-2 flex flex-wrap gap-3">
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded bg-accent-solid px-5 py-2.5 text-sm font-medium text-on-accent no-underline transition-colors hover:bg-accent-deep"
              >{t.home.openSource.ctaSource}</a
            >
            <a
              href={NPM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded border border-border-firm bg-paper px-5 py-2.5 text-sm font-medium text-ink no-underline transition-colors hover:border-accent hover:text-accent"
              >{t.home.openSource.ctaNpm}</a
            >
          </div>
        </div>

        <LicenceSheet />
      </div>
    </div>
  </section>

  <!-- The docs. Paper, so the page keeps alternating: the licence band above
       it is grey and the agent skill below it takes the grey back. -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
        <div class="flex max-w-2xl flex-col gap-4">
          <span
            class="font-mono text-[0.65rem] font-medium uppercase tracking-[0.16em] text-accent"
            >{t.home.docs.eyebrow}</span
          >
          <h2 class="m-0 text-3xl font-semibold sm:text-4xl">{t.home.docs.title}</h2>
          <p class="m-0 leading-relaxed text-muted">
            {t.home.docs.lead}
          </p>
        </div>
        <a
          href={localizePath("/docs/start-here/", locale)}
          class="text-sm font-medium whitespace-nowrap text-accent no-underline hover:underline"
          >{t.home.docs.ctaAll}</a
        >
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          CARDS.map((card, index) => (
            <a
              href={localizePath(card.href, locale)}
              class="group flex flex-col rounded-md border border-border bg-surface p-6 no-underline transition-colors hover:border-accent hover:bg-accent-tint"
            >
              <span class="mb-3.5 font-mono text-[0.65rem] tracking-[0.14em] text-muted tabular-nums">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="font-serif text-lg font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
                <span
                  class="ml-1 inline-block transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
              <span class="mt-1.5 text-sm leading-relaxed text-muted">{card.blurb}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Last, and deliberately so: it is the docs again, addressed to whatever is
       writing the code rather than to the person reading the page. -->
  <AgentSkill />

</Base>

<script>
  /**
   * Both copy buttons take their labels from the markup, so the script has no
   * English in it and works the same in every language.
   */
  function wireCopy(button: HTMLElement | null, value: () => string | undefined) {
    if (!button) return;

    button.addEventListener("click", async () => {
      const text = value();
      if (!text) return;

      // Read at click time, not at wire time: the checksum button's label is
      // rewritten when the registry answers, and a label captured before that
      // would restore the previous release's hash after the copied flash.
      const idle = button.dataset.idle ?? button.textContent?.trim() ?? "";
      const copied = button.dataset.copied ?? idle;
      const fallback = button.dataset.fallback ?? idle;
      const restore = () => setTimeout(() => (button.textContent = idle), 1600);
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = copied;
        restore();
      } catch {
        button.textContent = fallback;
        restore();
      }
    });
  }

  const command = document.getElementById("install-cmd");
  wireCopy(document.getElementById("copy-install"), () => command?.textContent ?? "");

  const integrity = document.getElementById("copy-integrity");
  wireCopy(integrity, () => integrity?.dataset.integrity);

  /**
   * The version and checksum are baked at build time, so they are right the
   * moment the site is built and stale the moment a release goes out without
   * one. This asks the registry what it is actually serving and corrects them
   * in place — the page never has to be rebuilt to stop lying.
   *
   * Failure is silence: no network, an offline reader or a registry hiccup all
   * leave the built-in values on screen, which are a real release either way.
   */
  async function refreshRelease() {
    const version = document.getElementById("release-version");
    if (!version?.dataset.latest || !integrity) return;

    const response = await fetch(version.dataset.latest, {
      headers: { accept: "application/vnd.npm.install-v1+json, application/json" },
    });
    if (!response.ok) return;

    const latest = await response.json();
    if (typeof latest?.version !== "string" || typeof latest?.dist?.integrity !== "string") return;

    version.textContent = `v${latest.version}`;

    // The button holds the full hash and shows a shortened one; both have to
    // move together or copying gives you the checksum of a different release.
    const title = integrity.getAttribute("title");
    if (title && integrity.dataset.integrity) {
      integrity.setAttribute("title", title.replace(integrity.dataset.integrity, latest.dist.integrity));
    }
    integrity.dataset.integrity = latest.dist.integrity;
    integrity.textContent = `${latest.dist.integrity.slice(0, 24)}…`;
  }

  refreshRelease().catch(() => {});
</script>

<style>
  .pull-quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.9vw, 2.15rem);
    line-height: 1.45;
    letter-spacing: -0.012em;
    /* Balanced rather than pretty: on a centred block of four or five lines,
       even line lengths matter more than avoiding a single short last line. */
    text-wrap: balance;
    /* Inherits from the band, so it stays legible on the green in both themes
       rather than pinning itself to the page ink colour. */
    color: inherit;
    /* Sits the type on the band's glow rather than in front of it. Wide and
       faint enough to read as depth rather than as a shadow. */
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.18);
  }
</style>
