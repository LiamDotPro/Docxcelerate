<script>
  /**
   * The integrity button takes its labels from the markup, so the script has
   * no English in it and works the same in every language.
   */
  const integrity = document.getElementById("copy-integrity");
  integrity?.addEventListener("click", async () => {
    const text = integrity.dataset.releaseIntegrity;
    if (!text) return;
    // Read at click time: the label is rewritten when the registry answers.
    const idle = integrity.textContent?.trim() ?? "";
    try {
      await navigator.clipboard.writeText(text);
      integrity.textContent = integrity.dataset.copied ?? idle;
    } catch {
      integrity.textContent = integrity.dataset.fallback ?? idle;
    }
    setTimeout(() => (integrity.textContent = idle), 1600);
  });

  // One template, two builds: the switch swaps which build the hero sheet
  // shows, and the caption that says what you are looking at.
  const frame = document.querySelector<HTMLIFrameElement>("[data-hero-frame]");
  const caption = document.querySelector<HTMLElement>("[data-hero-caption]");
  const modes = document.querySelectorAll<HTMLButtonElement>("[data-hero-mode]");
  modes.forEach((button) =>
    button.addEventListener("click", () => {
      const mode = button.dataset.heroMode as "engine" | "preview";
      modes.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
      if (frame && frame.dataset[mode]) frame.src = frame.dataset[mode]!;
      if (caption) caption.textContent = caption.dataset[mode] ?? "";
    }),
  );
</script>

