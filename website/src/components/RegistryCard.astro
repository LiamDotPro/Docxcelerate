---
/**
 * One entry in a gallery: what it is, what it costs you to add, and a way in.
 *
 * Deliberately plain. The galleries and the pages under them are laid out for
 * structure rather than for effect — the visual design is a separate pass, and
 * everything here is meant to be restyled rather than kept.
 */
import { asLocale, localizePath, ui } from "../i18n";

interface Props {
  href: string;
  title: string;
  summary: string;
  /** The command that installs it, printed rather than described. */
  command: string;
  /** Short labels: tags, fonts, export names — whatever the kind carries. */
  meta?: string[];
  /** Palette swatches, as CSS colours. Themes have them; components do not. */
  swatches?: string[];
}

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);
const { href, title, summary, command, meta = [], swatches = [] } = Astro.props;
---

<article
  class="flex flex-col gap-3 rounded-md border border-border bg-paper p-4 transition-colors hover:border-border-firm"
>
  <h3 class="m-0 text-base font-semibold">
    <a href={localizePath(href, locale)} class="text-ink no-underline hover:text-accent">
      {title}
    </a>
  </h3>

  <p class="m-0 text-sm leading-relaxed text-muted">{summary}</p>

  {
    swatches.length > 0 && (
      <div class="flex gap-1.5" aria-hidden="true">
        {swatches.map((colour) => (
          <span
            class="h-5 w-5 rounded-sm border border-border"
            style={`background: ${colour}`}
          />
        ))}
      </div>
    )
  }

  {
    meta.length > 0 && (
      <p class="m-0 font-mono text-xs text-muted">{meta.join(" · ")}</p>
    )
  }

  <p class="m-0 mt-auto font-mono text-xs text-muted">
    <span class="sr-only">{t.registry.install}: </span>{command}
  </p>
</article>
