---
import { DOC_GROUPS } from "../site";
import { byOrder, docsFor, type LocalisedDoc } from "../docs";
import { asLocale, localizePath, ui } from "../i18n";

interface Props {
  /** Language-independent, so the highlight survives a language switch. */
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);

const pages = await docsFor(locale);

/**
 * A group splits into its own pages and any subgroups beneath it. Subgroups
 * keep the order their first page gives them, so the sidebar's shape is set by
 * the same `order` field as everything else rather than a second list here.
 *
 * `group` and `subgroup` stay English in every translation — they are keys,
 * not copy. What a reader sees comes from the dictionary; an unrecognised
 * subgroup falls back to whatever the frontmatter said.
 */
const grouped = DOC_GROUPS.map((group) => {
  const groupPages = pages.filter((page) => page.entry.data.group === group).sort(byOrder);
  const subgroups: { title: string; label: string; pages: LocalisedDoc[] }[] = [];

  for (const page of groupPages) {
    const title = page.entry.data.subgroup;
    if (!title) continue;

    const existing = subgroups.find((entry) => entry.title === title);
    if (existing) {
      existing.pages.push(page);
    } else {
      subgroups.push({
        title,
        label: t.docs.subgroups[title as keyof typeof t.docs.subgroups] ?? title,
        pages: [page],
      });
    }
  }

  return {
    group,
    label: t.docs.groups[group],
    pages: groupPages.filter((page) => !page.entry.data.subgroup),
    subgroups,
  };
}).filter((entry) => entry.pages.length > 0 || entry.subgroups.length > 0);

const linkClass = (current: boolean) => [
  "block rounded px-3 py-1.5 no-underline transition-colors",
  current ? "bg-accent-tint font-semibold text-accent" : "text-muted hover:bg-surface hover:text-ink",
];

const hrefFor = (page: LocalisedDoc) => localizePath(`/docs/${page.slug}/`, locale);
---

<nav aria-label={t.docs.sidebarLabel} class="flex flex-col gap-7 text-sm">
  {
    grouped.map(({ label, pages: groupPages, subgroups }) => (
      <div class="flex flex-col gap-2">
        <h2 class="m-0 font-mono text-[0.65rem] font-medium uppercase tracking-[0.14em] text-muted">
          {label}
        </h2>

        {groupPages.length > 0 && (
          <ul class="m-0 -ml-3 flex list-none flex-col gap-0.5 p-0">
            {groupPages.map((page) => (
              <li class="m-0">
                <a
                  href={hrefFor(page)}
                  class:list={linkClass(page.slug === currentSlug)}
                  aria-current={page.slug === currentSlug ? "page" : undefined}
                >
                  {page.entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        )}

        {subgroups.map((subgroup) => (
          <div class="flex flex-col gap-0.5">
            <h3 class="m-0 mt-1 px-0 text-[0.7rem] font-medium uppercase tracking-[0.08em] text-muted opacity-70">
              {subgroup.label}
            </h3>
            {/* Indented and ruled: one glance says these belong to the line above. */}
            <ul class="m-0 flex list-none flex-col gap-0.5 border-l border-border p-0 pl-2">
              {subgroup.pages.map((page) => (
                <li class="m-0">
                  <a
                    href={hrefFor(page)}
                    class:list={linkClass(page.slug === currentSlug)}
                    aria-current={page.slug === currentSlug ? "page" : undefined}
                  >
                    {page.entry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))
  }
</nav>
