---
/**
 * /components — every prebuilt component, grouped by where in a document it
 * usually sits.
 *
 * Same arrangement as the theme gallery, and the same caveat: this is structure
 * for a visual pass to replace, not the design.
 */
import Base from "../layouts/Base.astro";
import RegistryCard from "./RegistryCard.astro";
import { addCommand, componentHref, componentsByCategory } from "../registry";
import { LOCALES } from "../i18n";
import { asLocale, localizePath, ui } from "../i18n";

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);
const groups = componentsByCategory();
---

<Base
  title={t.registry.components.title}
  description={t.registry.components.description}
  hreflangLocales={LOCALES}
>
  <div class="mx-auto flex max-w-5xl flex-col gap-10 px-5 py-12 sm:px-8">
    <header class="flex flex-col gap-4">
      <h1 class="m-0 text-3xl font-semibold">{t.registry.components.heading}</h1>
      <p class="m-0 max-w-2xl text-base leading-relaxed text-muted">
        {t.registry.components.lead}
      </p>
      <p class="m-0 font-mono text-sm text-muted">npx dxcl list components</p>
    </header>

    {
      groups.map(({ category, components }) => (
        <section class="flex flex-col gap-3">
          <h2 class="m-0 font-mono text-[0.65rem] font-medium uppercase tracking-[0.14em] text-muted">
            {category}
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {components.map((component) => (
              <RegistryCard
                href={componentHref(component.id)}
                title={component.title}
                summary={component.summary}
                command={addCommand(component.id)}
                meta={component.exports}
              />
            ))}
          </div>
        </section>
      ))
    }

    <p class="m-0">
      <a
        href={localizePath("/themes/", locale)}
        class="text-sm text-accent no-underline hover:underline"
      >
        {t.registry.themes.cta} →
      </a>
    </p>
  </div>
</Base>
