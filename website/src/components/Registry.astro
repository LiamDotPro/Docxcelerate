---
/**
 * /registry — one page answering "what can I add?".
 *
 * Themes at 01, components at 02, because that is the order somebody asks the
 * question in: what should this look like, then what is already written.
 *
 * Laid out to board 2a, with 3b's stacking below `sm`. Three things there are
 * load-bearing and easy to lose:
 *
 * - The two sections are **bands**, not a flex column with gaps. Each is a
 *   full-bleed hairline and its own ground — components sit on `--surface` so
 *   the page reads as two drawers rather than one long list.
 * - A theme card's specimen is drawn from that theme's own fonts, colours, page
 *   tint and margins. No screenshots, no iframes, no new catalog fields.
 * - Components are **rows**, not cards. A component is a thing you read across —
 *   preview, what it does, what it costs — and three columns say that where a
 *   grid of cards would just repeat the theme section in a different order.
 */
import Base from "../layouts/Base.astro";
import CopyField from "./CopyField.astro";
import Eyebrow from "./Eyebrow.astro";
import {
  addCommand,
  COMPONENTS,
  componentHref,
  componentsByFamily,
  THEMES,
  themeHref,
} from "../registry";
import { DEFAULT_SERIES_COLORS } from "docxcelerate/themes";
import { asLocale, localizePath, LOCALES, ui } from "../i18n";
import type {
  ComponentPageEntry,
  ResolvedNode,
  ThemeHeadingStyle,
  ThemePageEntry,
} from "../registry";

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);

/** A hex from the catalog, which stores them without the hash. */
const colour = (value: string | undefined, fallback: string) =>
  value && /^[0-9a-fA-F]{6}$/.test(value) ? `#${value}` : value ?? fallback;

/**
 * The type a theme sets its body in, as a CSS stack.
 *
 * The specimen has to be set in the theme's own face or it is not a specimen.
 * The named font first, then a generic so a machine without it still shows the
 * right *shape* of type rather than falling back to the site's sans.
 */
function fontStack(name: string): string {
  const serif = /(Georgia|Garamond|Times|Cambria|Book|Palatino|Iowan)/i.test(name);

  return `"${name}", ${serif ? "Georgia, serif" : "system-ui, sans-serif"}`;
}

const clamp = (value: number, low: number, high: number) =>
  Math.min(high, Math.max(low, Math.round(value)));

/** Swatches in the order a reader meets them: heading, accent, muted, rule. */
function swatches(theme: ThemePageEntry): string[] {
  const palette = theme.style.palette;

  return [palette?.heading, palette?.accent, palette?.muted, palette?.rule]
    .filter(Boolean)
    .map((value) => colour(value, "#000000"));
}

/**
 * Which of the two headings carries the theme's character.
 *
 * A theme that sets anything in capitals is recognised by that before it is
 * recognised by its title — "small-cap headings on slate" is the whole of Slate
 * Report's summary line — so the transform decides. Where the title itself is
 * transformed, or neither is, the title wins, because a title is what a reader
 * meets first on the page this stands in for.
 */
function characteristicHeading(theme: ThemePageEntry): ThemeHeadingStyle {
  const { title, sectionHeading } = theme.style;

  if (title.transform) return title;

  return sectionHeading.transform ? sectionHeading : title;
}

/**
 * The specimen's own measurements, taken from the theme rather than guessed.
 *
 * Two conversions matter. Point sizes become **pixels one for one**, not CSS
 * points: a card is a drawing of a page rather than a page, and 12pt rendered
 * at its true 16px would set a specimen half again as large as the boards. And
 * the padding is the theme's own margins brought down to card scale, so Warm
 * Letter's generous page and Slate Report's tight one differ on the card by the
 * thing that actually differs between them rather than by a number in a caption.
 */
function specimen(theme: ThemePageEntry) {
  const { typography, title, page, palette } = theme.style;
  const heading = characteristicHeading(theme);
  const caps = heading.transform === "uppercase";

  return {
    paper: colour(palette?.page, "#ffffff"),
    ink: colour(typography.color, "#111827"),
    // Always the title's colour, even when the size comes from the section
    // heading: a section heading's accent read as a title would make Slate
    // Report's teal look like the theme's ink.
    heading: colour(title.color ?? palette?.heading, "#111827"),
    rule: colour(palette?.rule, "#d5d9e0"),
    muted: colour(palette?.muted, "#6b7280"),
    body: fontStack(typography.bodyFont),
    display: fontStack(typography.headingFont),
    // Clamped at both ends: 30pt would be the whole specimen, 10pt would not
    // read as a heading at all.
    titleSize: `${clamp(heading.fontSizePt * 0.9, 11, 22)}px`,
    titleWeight: heading.weight === "bold" ? 700 : 600,
    titleTransform: caps ? "uppercase" : "none",
    titleSpacing: caps ? "0.07em" : "0",
    bodySize: `${Math.min(Math.max(typography.bodySizePt, 9.5), 11)}px`,
    // Loosened a notch. The theme's figure was chosen for 11pt on paper; the
    // specimen sets it at 11px on a screen, where the same ratio reads tight.
    // An offset rather than a floor, so Slate Report stays tighter than Warm
    // Letter — which is most of what separates them.
    lineHeight: Math.round((typography.bodyLineHeight + 0.15) * 100) / 100,
    padY: clamp(page.margins.topMm * 0.88, 14, 26),
    padX: clamp(page.margins.leftMm * 0.92, 16, 30),
    // The page size alone. The margin belongs on the detail page, and spelling
    // it out here is what put a chip the width of the card over the title.
    size: page.size === "LETTER" ? "LTR" : page.size,
  };
}

/**
 * A row's paper preview: what the component resolved to, in miniature.
 *
 * This used to be the first three strings the nodes carried, which worked for
 * as long as every component was words. It stopped the moment charts arrived:
 * a chart node holds no text, so a chart component previewed as one truncated
 * sentence and eighty pixels of nothing — the row that most needed a picture
 * was the row with no picture in it.
 *
 * So a node is now sketched as the *kind of thing* it is: a paragraph as its
 * line, a chart as a miniature drawn from its own cached numbers, a shape as
 * the band it prints, a picture as the space it takes. Everything comes out of
 * the resolved model — the same model the `.docx` is packed from — so it is a
 * small drawing of the document rather than a decoration beside it.
 */
type Sketch =
  | { kind: "line"; text: string }
  | {
    kind: "chart";
    graphType: string;
    /** Whether the series stack, and to a total or to a share. */
    stacked: boolean | "percent";
    /** The plotted numbers, at most four series of at most eight. */
    series: number[][];
    /** How many spokes a radar has, which is how many categories it counts. */
    slices: number;
    /** A scatter's or a bubble's x values, which are figures rather than names. */
    xs: number[];
    /** A bubble's third figure, empty for every other kind. */
    sizes: number[];
  }
  | { kind: "band"; text: string }
  | { kind: "image" };

/**
 * The numbers a chart node cached, as a plain grid with the gaps dropped.
 *
 * A stack is given twice the series a cluster is. Four clustered runs across
 * eight categories is thirty-two bars in a hundred and sixty pixels, which
 * reads as a barcode; four stacked ones are still four columns.
 */
function plotted(node: ResolvedNode, runs: number): number[][] {
  return (node.data?.series ?? [])
    .slice(0, runs)
    .map((series) =>
      (series.values ?? [])
        .slice(0, 8)
        .map((value) => (typeof value === "number" && Number.isFinite(value) ? value : 0))
    )
    .filter((values) => values.length > 0);
}

/**
 * What a component's first few nodes look like.
 *
 * Three entries at most, and a chart counts for two of them: a miniature needs
 * the height, and a row is 112px tall.
 */
function sketch(component: ComponentPageEntry): Sketch[] {
  const out: Sketch[] = [];
  let room = 3;

  const walk = (nodes: readonly ResolvedNode[]) => {
    for (const node of nodes) {
      if (room <= 0) return;

      if (node.kind === "graph") {
        const stacked = node.stacked ?? false;
        const series = plotted(node, stacked === false ? 2 : 4);

        if (series.length > 0) {
          out.push({
            kind: "chart",
            graphType: node.graphType ?? "bar",
            stacked,
            series,
            slices: node.data?.categories?.length ?? series[0].length,
            xs: (node.data?.categories ?? []).slice(0, 8).map(Number),
            sizes: (node.data?.series?.[0]?.sizes ?? [])
              .slice(0, 8)
              .map((size) => (typeof size === "number" && Number.isFinite(size) ? size : 0)),
          });
          room -= 2;
          continue;
        }
      }

      if (node.kind === "shape") {
        const text = node.children?.find((child) => child.text)?.text ?? node.title ?? "";
        out.push({ kind: "band", text });
        room -= 1;
        continue;
      }

      if (node.kind === "image") {
        out.push({ kind: "image" });
        room -= 1;
        continue;
      }

      if (node.text && node.text.trim() !== "") {
        out.push({ kind: "line", text: node.text });
        room -= 1;
        continue;
      }

      if (node.children) walk(node.children);
    }
  };

  walk(component.resolved);

  return out;
}

// ---------------------------------------------------------------------------
// The chart miniature
//
// Drawn here rather than framed from the rendered preview, for the reason the
// theme specimens are: an iframe per row is eleven documents loaded to show
// eleven thumbnails, and a screenshot is a picture that stops being true the
// moment the renderer changes. This is a drawing of the numbers the node
// actually cached, in the colours the packer would paint them, at the size a
// row has room for — a sketch of the chart, and honest about being one.
// ---------------------------------------------------------------------------

/** The miniature's own box, in the units its paths are written in. */
const MINI = { w: 160, h: 52 };

/** The hairline a miniature is ruled in. The paper here is fixed white. */
const MINI_RULE = "#D6DBE2";

/** The colour a series is drawn in: the packer's own order. */
const seriesColour = (index: number) =>
  `#${DEFAULT_SERIES_COLORS[index % DEFAULT_SERIES_COLORS.length]}`;

/** Every value across every series, so the drawing shares one scale. */
function ceiling(series: number[][]): number {
  const most = Math.max(...series.flat(), 0);

  return most === 0 ? 1 : most;
}

/**
 * Columns: clustered side by side, or stacked one on another.
 *
 * A percent stack draws every column to the full height, which is the whole
 * difference between it and an ordinary stack — and a miniature that clustered
 * it would show a reader the one chart the component exists to talk them out
 * of.
 */
function miniBars(series: number[][], stacked: boolean | "percent"): string {
  const count = series[0].length;
  const slot = MINI.w / count;
  const room = MINI.h - 4;

  if (stacked === false) {
    const top = ceiling(series);
    const width = Math.max(2, (slot * 0.68) / series.length);

    return series
      .flatMap((values, row) =>
        values.map((value, index) => {
          const height = Math.max(1, (value / top) * room);
          const x = index * slot + slot * 0.16 + row * width;

          return `<rect x="${x.toFixed(1)}" y="${(MINI.h - height).toFixed(1)}" width="${
            width.toFixed(1)
          }" height="${height.toFixed(1)}" fill="${seriesColour(row)}" rx="0.5"/>`;
        })
      )
      .join("");
  }

  const totals = series[0].map((_, index) =>
    series.reduce((sum, values) => sum + (values[index] ?? 0), 0)
  );
  // A percent stack shares no scale between columns — each is its own whole.
  // A stack to a total shares one, and the tallest column is the top.
  const tallest = Math.max(...totals, 1);
  const width = slot * 0.68;

  return series[0]
    .map((_, index) => {
      const total = totals[index];
      const full = stacked === "percent" ? room : (total / tallest) * room;
      let y = MINI.h;

      return series
        .map((values, row) => {
          const share = total === 0 ? 0 : (values[index] ?? 0) / total;
          const height = share * full;
          y -= height;

          return height < 0.4 ? "" : `<rect x="${(index * slot + slot * 0.16).toFixed(1)}" y="${
            y.toFixed(1)
          }" width="${width.toFixed(1)}" height="${height.toFixed(1)}" fill="${
            seriesColour(row)
          }"/>`;
        })
        .join("");
    })
    .join("");
}

/** A line, and the ground under it where the chart is an area. */
function miniLine(series: number[][], filled: boolean): string {
  const top = ceiling(series);

  return series
    .map((values, row) => {
      const step = values.length > 1 ? MINI.w / (values.length - 1) : 0;
      const points = values
        .map((value, index) =>
          `${(index * step).toFixed(1)},${(MINI.h - 3 - (value / top) * (MINI.h - 8)).toFixed(1)}`
        )
        .join(" ");
      const stroke =
        `<polyline points="${points}" fill="none" stroke="${seriesColour(row)}" stroke-width="2" ` +
        `stroke-linejoin="round" stroke-linecap="round"/>`;

      return filled
        ? `<polygon points="0,${MINI.h} ${points} ${MINI.w},${MINI.h}" fill="${
          seriesColour(row)
        }" opacity="0.22"/>${stroke}`
        : stroke;
    })
    .join("");
}

/** Wedges, with the middle taken out where it is a doughnut. */
function miniPie(values: number[], hollow: boolean): string {
  const total = values.reduce((sum, value) => sum + Math.max(value, 0), 0);
  const radius = MINI.h / 2 - 1;
  const cx = MINI.w / 2;
  const cy = MINI.h / 2;
  let angle = -Math.PI / 2;

  if (total === 0) {
    return "";
  }

  const wedges = values.map((value, index) => {
    const sweep = (Math.max(value, 0) / total) * Math.PI * 2;
    const to = angle + sweep;
    const large = sweep > Math.PI ? 1 : 0;
    const path = `M ${cx} ${cy} L ${(cx + radius * Math.cos(angle)).toFixed(2)} ${
      (cy + radius * Math.sin(angle)).toFixed(2)
    } A ${radius} ${radius} 0 ${large} 1 ${(cx + radius * Math.cos(to)).toFixed(2)} ${
      (cy + radius * Math.sin(to)).toFixed(2)
    } Z`;

    angle = to;

    return `<path d="${path}" fill="${seriesColour(index)}"/>`;
  });

  // The hole is painted rather than cut, because the paper behind a row's
  // preview is one fixed colour and a mask would be more machinery than that.
  return wedges.join("") +
    (hollow ? `<circle cx="${cx}" cy="${cy}" r="${radius * 0.5}" fill="var(--paper-fixed)"/>` : "");
}

/** A ring per series, on a web of the same spokes the chart has. */
function miniRadar(series: number[][], spokes: number): string {
  const top = ceiling(series);
  const radius = MINI.h / 2 - 2;
  const cx = MINI.w / 2;
  const cy = MINI.h / 2;
  const count = Math.max(spokes, 3);
  const at = (index: number, distance: number) => {
    const angle = -Math.PI / 2 + (index / count) * Math.PI * 2;

    return `${(cx + distance * Math.cos(angle)).toFixed(2)},${
      (cy + distance * Math.sin(angle)).toFixed(2)
    }`;
  };

  const web = `<polygon points="${
    Array.from({ length: count }, (_, index) => at(index, radius)).join(" ")
  }" fill="none" stroke="${MINI_RULE}" stroke-width="1"/>`;

  const rings = series.map((values, row) =>
    `<polygon points="${
      Array.from({ length: count }, (_, index) =>
        at(index, ((values[index] ?? 0) / top) * radius)).join(" ")
    }" fill="none" stroke="${seriesColour(row)}" stroke-width="1.6"/>`
  );

  return web + rings.join("");
}

/** Points, sized by their third figure where the chart carries one. */
function miniPoints(entry: Extract<Sketch, { kind: "chart" }>): string {
  const series = entry.series;
  const values = series[0];
  const xs = entry.xs;
  const sizes = entry.sizes;
  const widest = Math.max(...sizes, 0);
  const spanX = Math.max(...xs.filter(Number.isFinite), 1);
  const top = ceiling(series);

  return values
    .map((value, index) => {
      const x = Number.isFinite(xs[index]) ? (xs[index] / spanX) * (MINI.w - 12) + 6 : 6;
      const y = MINI.h - 4 - (value / top) * (MINI.h - 10);
      // Area, not radius — the same rule the real chart is drawn by, and it
      // matters more here where there is less room to be wrong in.
      const r = widest > 0 ? 1.5 + 6.5 * Math.sqrt((sizes[index] ?? 0) / widest) : 3;

      return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r.toFixed(1)}" fill="${
        seriesColour(0)
      }" opacity="0.75"/>`;
    })
    .join("");
}

/** One chart node, as the SVG a row shows in place of it. */
function miniChart(entry: Extract<Sketch, { kind: "chart" }>): string {
  const { graphType, series } = entry;
  const body = graphType === "pie" || graphType === "doughnut"
    ? miniPie(series[0], graphType === "doughnut")
    : graphType === "radar"
    ? miniRadar(series, entry.slices)
    : graphType === "scatter" || graphType === "bubble"
    ? miniPoints(entry)
    : graphType === "line" || graphType === "area"
    ? miniLine(series, graphType === "area")
    : miniBars(series, entry.stacked);

  // A baseline under everything measured against one, which is what makes a
  // row of bars read as a chart rather than as a bar code.
  const base = ["pie", "doughnut", "radar"].includes(graphType)
    ? ""
    : `<line x1="0" y1="${MINI.h}" x2="${MINI.w}" y2="${MINI.h}" stroke="${MINI_RULE}" stroke-width="1"/>`;

  return `<svg viewBox="0 0 ${MINI.w} ${MINI.h}" width="100%" height="${MINI.h}" ` +
    `preserveAspectRatio="xMidYMid meet" role="presentation" focusable="false">${base}${body}</svg>`;
}

/**
 * The tags worth filtering by.
 *
 * Only those carried by more than one entry. A tag on a single entry filters
 * eleven cards down to that one — which is a link to it, not a filter — and
 * eighteen of those in a row buries the handful that actually group anything.
 */
const tagIndex = (() => {
  const counts = new Map<string, number>();

  for (const entry of [...THEMES, ...COMPONENTS]) {
    for (const tag of entry.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }

  return [...counts.entries()]
    .filter(([, count]) => count > 1)
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .map(([tag, count]) => ({ tag, count }));
})();

const themes = THEMES.map((theme) => ({ theme, spec: specimen(theme), swatches: swatches(theme) }));

/**
 * The components, grouped by what they are made of.
 *
 * Thirteen rows in one list is a list you scroll rather than read, and the
 * question somebody arrives with is usually "is there a chart for this?" —
 * which the family answers and `category` does not.
 */
const families = componentsByFamily().map((group) => ({
  family: group.family,
  rows: group.components.map((component) => ({ component, sketch: sketch(component) })),
}));

/** Every band shares one measure and one set of gutters — the nav's, so the
 *  eyebrow, the heading and the first card hang off the same left edge as the
 *  wordmark above them. Widening the gutters here breaks that line. */
const band = "mx-auto flex max-w-6xl flex-col px-5 sm:px-8";
---

<Base title={t.registry.browse.title} description={t.registry.browse.description} hreflangLocales={LOCALES}>
  <header class:list={[band, "gap-[18px] pt-8 pb-7 lg:pt-14 lg:pb-11"]}>
    <Eyebrow>{t.registry.browse.eyebrow}</Eyebrow>
    <h1 class="m-0 font-serif text-[1.7rem] font-semibold leading-[1.1] tracking-[-0.02em] sm:text-4xl">
      {t.registry.browse.heading}
    </h1>
    <p class="m-0 max-w-[40rem] text-[0.95rem] leading-[1.7] text-muted sm:text-[1.05rem]">
      {t.registry.browse.lead}
    </p>
    <CopyField command="npx dxcl list" class="w-full sm:w-60" />

    <div class="mt-1 flex flex-wrap items-center gap-2" data-tag-filter>
      <span
        class="mr-1.5 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted"
        id="tag-filter-label"
      >
        {t.registry.browse.filterByTag}
      </span>
      {
        tagIndex.map(({ tag, count }) => (
          <button
            type="button"
            class="inline-flex items-baseline gap-1.5 rounded-full border border-firm px-[11px] py-[3px] font-mono text-[0.68rem] text-ink transition-colors hover:border-default hover:bg-surface aria-pressed:border-accent aria-pressed:bg-accent-tint aria-pressed:text-accent"
            data-tag={tag}
            aria-pressed="false"
          >
            {tag} <span class="text-muted">{count}</span>
          </button>
        ))
      }
    </div>
  </header>

  <!-- 01 — Themes. On paper: the first drawer. -->
  <section class="border-t border-default" id="themes" data-section>
    <div class:list={[band, "gap-6 py-7 lg:pt-11 lg:pb-13"]}>
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <Eyebrow index={1}>{t.registry.themes.heading}</Eyebrow>
        <span class="font-mono text-[0.68rem] text-muted">{t.registry.browse.themesNote}</span>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          themes.map(({ theme, spec, swatches }) => (
            <article
              class="flex flex-col overflow-hidden rounded-md border border-default bg-paper transition-colors hover:border-firm"
              data-entry
              data-tags={theme.tags.join(" ")}
            >
              {/* The specimen: this theme's own type, colour, tint and margins. */}
              <a
                href={localizePath(themeHref(theme.id), locale)}
                class="relative block min-h-[120px] border-b border-default no-underline sm:min-h-[150px]"
                style={`background:${spec.paper};padding:${spec.padY}px ${spec.padX}px;`}
                aria-label={theme.title}
              >
                <span
                  class="absolute right-3 top-2.5 font-mono text-[0.6rem] tracking-[0.08em]"
                  style={`color:${spec.muted};`}
                >
                  {spec.size}
                </span>
                <div
                  class="max-w-[88%]"
                  style={`font-family:${spec.display};font-size:${spec.titleSize};font-weight:${spec.titleWeight};color:${spec.heading};text-transform:${spec.titleTransform};letter-spacing:${spec.titleSpacing};line-height:1.15;`}
                >
                  Membership renewal
                </div>
                <div class="mt-[9px] h-px" style={`background:${spec.rule};`} />
                <p
                  class="m-0 mt-[10px]"
                  style={`font-family:${spec.body};font-size:${spec.bodySize};line-height:${spec.lineHeight};color:${spec.ink};`}
                >
                  Your tenancy at 14 Glebe Road ends on 30 September. This letter sets out what
                  happens next, and what we need from you before then.
                </p>
              </a>

              <div class="flex flex-1 flex-col gap-2 px-5 py-[18px]">
                <div class="flex items-baseline justify-between gap-3">
                  <a
                    href={localizePath(themeHref(theme.id), locale)}
                    class="font-serif text-[1.05rem] font-semibold text-ink no-underline hover:text-accent"
                  >
                    {theme.title}
                  </a>
                  <span class="whitespace-nowrap font-mono text-[0.6rem] uppercase tracking-[0.08em] text-muted">
                    {theme.category}
                  </span>
                </div>
                <p class="m-0 text-[0.85rem] leading-[1.6] text-muted">{theme.summary}</p>
                <div class="flex items-center justify-between gap-2.5">
                  <span class="font-mono text-[0.66rem] text-muted">{theme.fonts.join(" · ")}</span>
                  <div class="flex gap-1">
                    {swatches.map((value) => (
                      <span
                        class="h-[13px] w-[13px] rounded-[3px] border border-default"
                        style={`background:${value}`}
                      />
                    ))}
                  </div>
                </div>
                <CopyField command={addCommand(theme.id)} compact class="mt-auto" />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 02 — Components. On surface: the second drawer, read as rows. -->
  <section class="border-t border-default bg-surface" id="components" data-section>
    <div class:list={[band, "gap-4 py-7 lg:pt-11 lg:pb-13"]}>
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <Eyebrow index={2}>{t.registry.components.heading}</Eyebrow>
        <span class="font-mono text-[0.68rem] text-muted">{t.registry.browse.componentsNote}</span>
      </div>

      {
        families.map(({ family, rows }) => (
          <div class="flex flex-col gap-4 lg:gap-0" data-group>
            {/* The family, as a rule with a word on it. A heading here would
                compete with the band's own; what this has to do is separate. */}
            <div class="mt-5 flex items-baseline gap-3 lg:mt-7">
              <Eyebrow class="text-[0.6rem] whitespace-nowrap">{family}</Eyebrow>
              <span class="h-px grow bg-[var(--border-default)]" />
              {/* Follows the filter. A family headed "6" over two rows is the
                  heading disagreeing with what is under it. */}
              <span class="font-mono text-[0.62rem] text-muted" data-group-count>{rows.length}</span>
            </div>

            {rows.map(({ component, sketch }) => (
            <article
              class="border-default bg-paper max-lg:overflow-hidden max-lg:rounded-md max-lg:border lg:grid lg:grid-cols-[190px_minmax(0,1fr)_320px] lg:items-center lg:gap-8 lg:border-t lg:bg-transparent lg:py-[22px]"
              data-entry
              data-tags={component.tags.join(" ")}
            >
              {/* What its nodes resolved to, on paper that stays white at night. */}
              <a
                href={localizePath(componentHref(component.id), locale)}
                class="flex min-h-[88px] flex-col justify-center overflow-hidden px-4 py-3.5 no-underline max-lg:border-b lg:h-28 lg:min-h-0 lg:rounded lg:border"
                style="background:var(--paper-fixed);border-color:var(--paper-fixed-border);font-family:Calibri,'Segoe UI',sans-serif;"
              >
                {
                  sketch.length === 0
                    ? <span class="text-xs" style="color:#657287">{t.registry.browse.noPreview}</span>
                    : sketch.map((entry, index) => (
                      entry.kind === "chart"
                        ? <div class="mt-1" set:html={miniChart(entry)} />
                        : entry.kind === "band"
                        ? (
                          <div
                            class="truncate rounded-[2px] px-1.5 py-1 leading-[1.4]"
                            style={`font-size:10.5px;font-weight:700;color:#ffffff;background:${
                              seriesColour(1)
                            };margin-top:${index === 0 ? 0 : 4}px;`}
                          >
                            {entry.text}
                          </div>
                        )
                        : entry.kind === "image"
                        ? (
                          <div
                            class="rounded-[2px]"
                            style={`height:16px;width:52px;background:#E3E7ED;margin-top:${
                              index === 0 ? 0 : 5
                            }px;`}
                          />
                        )
                        : (
                          <div
                            class="truncate leading-[1.45]"
                            style={index === 0
                              ? "font-size:12.5px;font-weight:700;color:#111827;"
                              : "font-size:11px;color:#1f2937;margin-top:4px;"}
                          >
                            {entry.text}
                          </div>
                        )
                    ))
                }
              </a>

              <div class="flex flex-col gap-1.5 px-5 py-4 lg:px-0 lg:py-0">
                <Eyebrow class="text-[0.6rem]">{component.category}</Eyebrow>
                <a
                  href={localizePath(componentHref(component.id), locale)}
                  class="font-serif text-[1.05rem] font-semibold text-ink no-underline hover:text-accent lg:text-[1.15rem]"
                >
                  {component.title}
                </a>
                <p class="m-0 text-[0.85rem] leading-[1.6] text-muted sm:text-[0.875rem]">
                  {component.summary}
                </p>
                <span class="hidden font-mono text-[0.66rem] leading-[1.8] text-muted lg:inline">
                  {t.registry.browse.readsPrefix} {component.dataFields.map((field) => field.path).join(", ")}
                </span>
                <div class="mt-0.5 hidden flex-wrap gap-1.5 lg:flex">
                  {component.tags.map((tag) => (
                    <span class="inline-flex rounded-full border border-firm px-[7px] py-px font-mono text-[0.6rem] uppercase tracking-[0.08em] text-muted">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex flex-col gap-2 px-5 pb-4 lg:px-0 lg:pb-0">
                <CopyField command={addCommand(component.id)} compact />
                <span class="hidden font-mono text-[0.66rem] text-muted lg:inline">
                  {t.registry.exportsResolves
                    .replace("{exports}", component.exports.join(", "))
                    .replace("{count}", String(component.resolved.length))}
                </span>
              </div>
            </article>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Nothing matched the filter. One action, no apology copy. -->
  <section class="border-t border-default" data-empty hidden>
    <div class:list={[band, "items-start gap-2 py-12"]}>
      <Eyebrow tone="muted">{t.registry.browse.noMatchesTitle}</Eyebrow>
      <p class="m-0 text-[0.9rem] leading-[1.6] text-ink" data-empty-line data-template={t.registry.browse.noMatches} data-and={t.registry.browse.andJoin}></p>
      <p class="m-0 text-[0.8rem] leading-[1.6] text-muted">{t.registry.browse.noMatchesNote}</p>
      <button
        type="button"
        class="mt-2 inline-flex min-h-[44px] items-center rounded border border-firm bg-transparent px-5 text-sm font-medium text-accent transition-colors hover:bg-accent-tint sm:min-h-0 sm:py-2.5"
        data-clear-tags
      >
        {t.registry.browse.clearFilter}
      </button>
    </div>
  </section>
</Base>

<script>
  // Tag filtering, in the page rather than the URL: it is a way of looking at
  // one list, not a place you would link somebody to.
  //
  // Tags are additive and each one narrows, so a chip already on turns itself
  // off when pressed again — which is also the only way back to everything,
  // and the reason there is no "all" chip to keep in step with the rest.
  const bar = document.querySelector("[data-tag-filter]");
  const entries = [...document.querySelectorAll<HTMLElement>("[data-entry]")];
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const emptyLine = document.querySelector<HTMLElement>("[data-empty-line]");
  const sections = [...document.querySelectorAll<HTMLElement>("[data-section]")];
  const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
  const chosen = new Set<string>();

  function apply() {
    let shown = 0;

    for (const button of bar?.querySelectorAll<HTMLButtonElement>("[data-tag]") ?? []) {
      button.setAttribute("aria-pressed", String(chosen.has(button.dataset.tag ?? "")));
    }

    for (const entry of entries) {
      const tags = (entry.dataset.tags ?? "").split(" ");
      const match = [...chosen].every((tag) => tags.includes(tag));
      entry.hidden = !match;
      if (match) shown += 1;
    }

    // A family whose every row is filtered out is a rule with a word on it and
    // nothing under it. Hidden before the sections, because a section is only
    // empty once all of its groups are.
    for (const group of groups) {
      const visible = [...group.querySelectorAll<HTMLElement>("[data-entry]")]
        .filter((entry) => !entry.hidden);
      const count = group.querySelector<HTMLElement>("[data-group-count]");

      group.hidden = visible.length === 0;
      if (count) count.textContent = String(visible.length);
    }

    // A section whose every entry is filtered out is a heading over nothing, so
    // it goes with them rather than sitting there empty.
    for (const section of sections) {
      const visible = [...section.querySelectorAll<HTMLElement>("[data-entry]")]
        .some((entry) => !entry.hidden);
      section.hidden = !visible;
    }

    if (empty) empty.hidden = shown > 0;
    if (emptyLine) {
      // "money and legal" reads as the sentence it is in; a comma-joined list
      // would not.
      const listed = [...chosen].join(` ${emptyLine.dataset.and ?? "and"} `);
      emptyLine.textContent = emptyLine.dataset.template?.replace("{tag}", listed) ?? "";
    }
  }

  bar?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-tag]");
    if (!button) return;

    const tag = button.dataset.tag ?? "";
    if (chosen.has(tag)) chosen.delete(tag);
    else chosen.add(tag);
    apply();
  });

  document.querySelector("[data-clear-tags]")?.addEventListener("click", () => {
    chosen.clear();
    apply();
  });
</script>
