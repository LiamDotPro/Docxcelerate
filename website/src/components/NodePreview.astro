---
/**
 * A node as the renderer draws it — written at build time by the same renderer
 * the CLI serves, so this is the node rather than a picture of one.
 *
 * Framed rather than inlined because the renderer ships its own stylesheet: an
 * iframe keeps the letter's typography off the site and the site's off the
 * letter.
 */
interface Props {
  src: string;
  /** Describes the frame to a screen reader; also the fallback link text. */
  title: string;
  /** Small caption under the paper. */
  label?: string;
  /**
   * Drop the trailing margin, for a caller that spaces its own children.
   * The margin is what separates the paper from the prose that follows it;
   * inside a gapped column it only makes one gap bigger than the rest.
   */
  flush?: boolean;
}

const { src, title, label, flush = false } = Astro.props;
---

<figure class:list={["node-preview", flush && "flush"]}>
  <div class="paper">
    <iframe
      data-node-frame
      src={src}
      title={title}
      loading="lazy"
      scrolling="no"
      class="frame"></iframe>
  </div>
  <figcaption>
    <span>{label ?? "Rendered by Docxcelerate at build time"}<slot /></span>
    <a href={src} target="_blank" rel="noopener noreferrer">Open ↗</a>
  </figcaption>
</figure>

<script>
  // One handler for every preview on the page — Astro hoists this module once
  // however many times the component is used.
  const frames = Array.from(document.querySelectorAll<HTMLIFrameElement>("[data-node-frame]"));

  /**
   * Sits one sheet in its frame. Same origin, so both the sheet's own width
   * and the height it drew at are readable rather than guessed.
   *
   * The page inside is the document's page — as wide as the file says, with
   * the margins the file gives it — so it is nearly always wider than the
   * column it is shown in. It is scaled to fit rather than reflowed: scaling
   * is what Word's own zoom does, while a sheet narrowed to the card would
   * wrap its lines somewhere else and clip a chart whose frame is a fixed
   * width. The iframe keeps its full width and the transform does the fitting,
   * so nothing inside the page is laid out for a width Word would not use.
   */
  function fit(frame: HTMLIFrameElement) {
    const body = frame.contentDocument?.body;
    const paper = frame.parentElement;
    if (!body || !paper) return;

    const sheet = body.querySelector("section.docx");
    const natural = Math.ceil(sheet?.getBoundingClientRect().width ?? 0);
    const available = paper.clientWidth;
    if (natural <= 0 || available <= 0) return;

    // Scaled down to fit, never up: a node whose page is narrower than the
    // card is shown at its own size rather than blown up to fill the width.
    const scale = Math.min(1, available / natural);

    // Width first — the height is whatever the page drew at that width.
    frame.style.width = `${natural}px`;
    const height = Math.ceil(body.scrollHeight);
    if (height <= 0) return;

    frame.style.height = `${height}px`;
    frame.style.transform = scale === 1 ? "" : `scale(${scale})`;
    // The transform is not layout, so the paper is still as tall as the
    // unscaled frame unless it is told otherwise.
    paper.style.height = `${Math.ceil(height * scale)}px`;
  }

  // The paper is what changes width, not the frame — the frame is sized to the
  // sheet. Tracking the last width means our own writes don't feed back in.
  const widths = new WeakMap<Element, number>();
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const width = entry.contentRect.width;
      if (widths.get(entry.target) === width) continue;
      widths.set(entry.target, width);

      const frame = entry.target.querySelector<HTMLIFrameElement>("[data-node-frame]");
      if (frame) fit(frame);
    }
  });

  for (const frame of frames) {
    frame.addEventListener("load", () => {
      fit(frame);
      // Measured again once the letter's own fonts have settled — a swap after
      // the first measurement changes the line count and leaves a gap.
      frame.contentDocument?.fonts?.ready.then(() => fit(frame));
    });
    // Lazy frames load later; eager ones may already be done by now.
    if (frame.contentDocument?.readyState === "complete") fit(frame);
    if (frame.parentElement) observer.observe(frame.parentElement);
  }
</script>

<style>
  .node-preview {
    margin: 0 0 1.35rem;
  }

  /* The caller spaces its own children. */
  .node-preview.flush {
    margin-bottom: 0;
  }

  /* Paper is white in both themes. A letter preview that dims at night stops
     reading as paper, and the claim of the toolkit is that this IS the page. */
  .paper {
    background: #ffffff;
    border: 1px solid var(--border-firm);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(0 0 0 / 5%), 0 10px 24px -18px rgb(0 0 0 / 35%);
  }

  .frame {
    display: block;
    /* Both replaced on load with the sheet's own width and the height it drew
       at; these are only what an unloaded or blocked frame occupies. */
    width: 100%;
    height: 7rem;
    border: 0;
    background: #ffffff;
    color-scheme: light;
    /* Scaled from the top left so the sheet's own top-left corner stays in the
       paper's, whatever the scale works out to. */
    transform-origin: top left;
  }

  figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  figcaption a {
    flex: none;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-firm);
  }

  figcaption a:hover {
    color: var(--accent);
  }
</style>
