---
/**
 * /themes — every theme the toolkit ships, in whatever language the URL asks
 * for.
 *
 * Lives here rather than in src/pages so `/themes/` and `/[locale]/themes/` are
 * two addresses for one page. Everything on it comes from the generated
 * registry: the site describes no theme itself.
 *
 * The layout is structural, not designed. It exists so the routes, the data and
 * the strings are in place for a visual pass to replace.
 */
import Base from "../layouts/Base.astro";
import RegistryCard from "./RegistryCard.astro";
import { addCommand, themeHref, themesByCategory } from "../registry";
import { LOCALES } from "../i18n";
import { asLocale, localizePath, ui } from "../i18n";

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);
const groups = themesByCategory();

/** Named by the job each colour does, so the swatches read left to right. */
function swatchesFor(palette: Record<string, string> | undefined): string[] {
  if (!palette) return [];

  return [palette.heading, palette.accent, palette.muted, palette.rule, palette.page]
    .filter(Boolean)
    .map((colour) => (/^[0-9a-fA-F]{6}$/.test(colour) ? `#${colour}` : colour));
}
---

<Base
  title={t.registry.themes.title}
  description={t.registry.themes.description}
  hreflangLocales={LOCALES}
>
  <div class="mx-auto flex max-w-5xl flex-col gap-10 px-5 py-12 sm:px-8">
    <header class="flex flex-col gap-4">
      <h1 class="m-0 text-3xl font-semibold">{t.registry.themes.heading}</h1>
      <p class="m-0 max-w-2xl text-base leading-relaxed text-muted">
        {t.registry.themes.lead}
      </p>
      <p class="m-0 font-mono text-sm text-muted">npx dxcl list themes</p>
    </header>

    {
      groups.map(({ category, themes }) => (
        <section class="flex flex-col gap-3">
          <h2 class="m-0 font-mono text-[0.65rem] font-medium uppercase tracking-[0.14em] text-muted">
            {category}
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {themes.map((theme) => (
              <RegistryCard
                href={themeHref(theme.id)}
                title={theme.title}
                summary={theme.summary}
                command={addCommand(theme.id)}
                meta={[
                  ...theme.fonts,
                  `${theme.style.page.size} ${theme.style.typography.bodySizePt}pt`,
                ]}
                swatches={swatchesFor(theme.style.palette)}
              />
            ))}
          </div>
        </section>
      ))
    }

    <p class="m-0">
      <a
        href={localizePath("/components/", locale)}
        class="text-sm text-accent no-underline hover:underline"
      >
        {t.registry.components.cta} →
      </a>
    </p>
  </div>
</Base>
