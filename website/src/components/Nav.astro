---
import { NAV, SITE } from "../site";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import { asLocale, localizePath, stripLocale, ui } from "../i18n";

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);

// Compared without the language prefix, so /de/docs/... highlights Docs the
// same way /docs/... does.
const path = stripLocale(Astro.url.pathname);

/** The top-level section a canonical path belongs to — "/docs", "/" and so on. */
const sectionOf = (href: string) => `/${href.split("/")[1] ?? ""}`;
---

<header
  class="sticky top-0 z-40 border-b border-border bg-paper/85 backdrop-blur-sm"
>
  <div
    class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-5 sm:px-8"
  >
    <a
      href={localizePath("/", locale)}
      class="font-serif text-lg font-semibold tracking-tight text-ink no-underline"
      aria-label={SITE.name}
    >
      Docx<span class="text-accent">celerate</span>
    </a>

    <nav aria-label={t.nav.label} class="ml-auto flex items-center gap-5 text-sm">
      {
        NAV.map((link) => {
          const label = t.nav[link.key];
          const current = !link.external && path.startsWith(sectionOf(link.href));
          const href = link.external ? link.href : localizePath(link.href, locale);
          return (
            <a
              href={href}
              class:list={[
                "inline-flex items-center gap-1.5 no-underline transition-colors hover:text-accent",
                current ? "font-semibold text-accent" : "text-muted",
              ]}
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              aria-current={current ? "page" : undefined}
              aria-label={link.icon ? label : undefined}
              title={link.icon ? label : undefined}
            >
              {
                link.icon === "github" ? (
                  <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                  </svg>
                ) : (
                  <>
                    {label}
                    {link.external && <span aria-hidden="true">↗</span>}
                  </>
                )
              }
              {
                link.soon && (
                  <span class="rounded-full border border-border-firm px-1.5 py-px font-mono text-[0.6rem] uppercase tracking-[0.08em] text-muted">
                    {t.common.soon}
                  </span>
                )
              }
            </a>
          );
        })
      }

      <LocaleSwitcher />

      <button
        type="button"
        id="theme-toggle"
        class="grid size-8 place-items-center rounded border border-border text-muted transition-colors hover:border-border-firm hover:text-accent"
        aria-label={t.nav.switchTheme}
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 3v1.5M12 19.5V21M3 12h1.5M19.5 12H21M5.6 5.6l1.1 1.1M17.3 17.3l1.1 1.1M18.4 5.6l-1.1 1.1M6.7 17.3l-1.1 1.1" stroke-linecap="round" />
          <circle cx="12" cy="12" r="3.8" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById("theme-toggle");
  button?.addEventListener("click", () => {
    const root = document.documentElement;
    const explicit = root.getAttribute("data-theme");
    const currentlyDark = explicit
      ? explicit === "dark"
      : window.matchMedia("(prefers-color-scheme: dark)").matches;
    const next = currentlyDark ? "light" : "dark";
    root.setAttribute("data-theme", next);
    localStorage.setItem("dxcl-theme", next);
  });
</script>
