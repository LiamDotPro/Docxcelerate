---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import { SITE } from "../site";
import { asLocale, ui } from "../i18n";
import type { Locale } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  /** Docs pages manage their own width; the homepage runs full-bleed. */
  bare?: boolean;
  /** Passed through to Seo — see there for what each one decides. */
  hreflangLocales?: readonly Locale[];
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

// Derived from the URL by Astro's i18n routing: /de/... is German, everything
// unprefixed is English. Pages never have to pass it down.
const locale = asLocale(Astro.currentLocale);
const t = ui(locale);

const {
  title,
  description = t.meta.description,
  bare = false,
  hreflangLocales,
  noindex,
  structuredData,
} = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${t.meta.tagline}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Four icons, because four different consumers ask four different
         questions. The SVG carries a `prefers-color-scheme` rule so the mark
         stays legible on a light tab strip and a dark one; the ICO cannot ask,
         so it is the monochrome cut reversed out of brand green, which holds
         against either. Both are declared: browsers that understand the SVG
         prefer it, and the rest fall back without a request for a file that
         isn't there. See scripts/build-brand-assets.mjs. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1a15" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={fullTitle}
      description={description}
      hreflangLocales={hreflangLocales}
      noindex={noindex}
      structuredData={structuredData}
    />
    <!-- Set the theme before first paint so there's no flash of the wrong ground. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("dxcl-theme");
        if (stored === "dark" || stored === "light") {
          document.documentElement.setAttribute("data-theme", stored);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-accent-solid focus:px-3 focus:py-2 focus:text-on-accent"
      >{t.common.skipToContent}</a
    >
    <Nav />
    <main id="main" class={bare ? "flex-1" : "flex-1 w-full"}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
