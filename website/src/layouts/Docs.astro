---
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import { DOC_GROUPS, GITHUB_URL, SITE } from "../site";
import { asLocale, fill, localizePath, ui } from "../i18n";
import { localesForDocsSlug } from "../seo";
import { markdownPath } from "../markdown";
import { docsFor, inReadingOrder } from "../docs";
import release from "../generated/release.json";

interface Props {
  title: string;
  description: string;
  group: (typeof DOC_GROUPS)[number];
  /** Language-independent, so the sidebar highlight survives a switch. */
  slug: string;
  /** Collection id of the file actually rendered — what Edit opens. */
  entryId: string;
  /** False when English is standing in for a missing translation. */
  translated: boolean;
  headings: MarkdownHeading[];
}

const { title, description, group, slug, entryId, translated, headings } = Astro.props;

const locale = asLocale(Astro.currentLocale);
const t = ui(locale);

// Points at the file on screen, so a reader fixing a German typo edits the
// German source rather than the English original.
const editUrl = `${GITHUB_URL}/edit/main/website/src/content/docs/${entryId}.mdx`;

// This page with `.md` on the end: the source, without the chrome around it.
// Worth a visible link rather than a rule only agents know — a reader handing
// the page to one gets to see the address exists.
const markdownUrl = localizePath(markdownPath(slug), locale);

// Only the languages that have this page are offered as translations of it.
// Where English is standing in, the page serves but stays out of the index —
// otherwise the same English prose competes with itself at five addresses.
const hreflangLocales = await localesForDocsSlug(slug);

// The whole docs set in sidebar order, so previous and next run across group
// boundaries the way a reader working down the sidebar would.
const allPages = await docsFor(locale);
const ordered = DOC_GROUPS.flatMap((name) =>
  inReadingOrder(allPages.filter((page) => page.entry.data.group === name)),
);
const here = ordered.findIndex((page) => page.slug === slug);
const neighbour = (offset: number) => {
  const page = ordered[here + offset];
  if (here < 0 || !page) return undefined;
  return {
    title: page.entry.data.title,
    href: localizePath(`/docs/${page.slug}/`, locale),
    number: groupNumber(page.slug, page.entry.data.group),
  };
};
// A page's number is its place in its own group, as the breadcrumb prints it.
function groupNumber(pageSlug: string, pageGroup: string) {
  const inGroup = inReadingOrder(allPages.filter((page) => page.entry.data.group === pageGroup));
  return String(inGroup.findIndex((page) => page.slug === pageSlug) + 1).padStart(2, "0");
}
const number = groupNumber(slug, group);
const previous = neighbour(-1);
const next = neighbour(1);
const url = (path: string) => new URL(localizePath(path, locale), Astro.site).href;

const structuredData = [
  {
    "@type": "TechArticle",
    headline: title,
    description,
    inLanguage: locale,
    url: url(`/docs/${slug}/`),
    isPartOf: { "@type": "WebSite", name: SITE.name, url: url("/") },
  },
  {
    "@type": "BreadcrumbList",
    // Only the last item may omit a URL, and groups have no page of their own,
    // so the trail is site, docs, page — with the group named on the page item.
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE.name, item: url("/") },
      { "@type": "ListItem", position: 2, name: t.nav.docs, item: url("/docs/start-here/") },
      { "@type": "ListItem", position: 3, name: `${t.docs.groups[group]}: ${title}` },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  hreflangLocales={hreflangLocales}
  noindex={!translated}
  structuredData={structuredData}
>
  <div class="mx-auto flex w-full max-w-6xl gap-10 px-5 sm:px-8 lg:gap-12">
    <!-- Left rail -->
    <aside class="hidden w-52 shrink-0 border-r border-default pr-5 lg:block">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto py-12">
        <Sidebar currentSlug={slug} />
      </div>
    </aside>

    <!-- Article -->
    <article class="doc-prose min-w-0 flex-1 pt-14 pb-24">
      <p
        class="m-0 flex flex-wrap items-center gap-2.5 font-mono text-[0.68rem] tracking-[0.12em] text-muted uppercase"
      >
        <span>{t.nav.docs}</span><span aria-hidden="true">/</span><span>{t.docs.groups[group]}</span><span
          aria-hidden="true">/</span
        ><span class="text-accent">{number}</span>
      </p>
      <h1 class="doc-title">{title}</h1>
      <p class="mt-0 mb-7 text-[1.25rem] leading-[1.6] text-pretty text-muted">{description}</p>

      <p
        class:list={[
          "m-0 flex flex-wrap gap-x-4 gap-y-1 border-y border-default py-3 font-mono text-[0.7rem] text-muted",
          translated ? "mb-10" : "mb-6",
        ]}
      >
        <span>{fill(t.docs.renderedAgainst, { version: `v${release.version}` })}</span>
        <span aria-hidden="true">·</span>
        <a href={markdownUrl} class="meta-link">{t.docs.viewAsMarkdown}</a>
        <span aria-hidden="true">·</span>
        <a href={editUrl} target="_blank" rel="noopener noreferrer" class="meta-link">{t.docs.editOnGithub}</a>
      </p>

      {
        !translated && (
          <p class="mb-10 rounded border border-border-firm bg-surface px-4 py-3 text-sm text-muted">
            {t.docs.untranslatedNote}
          </p>
        )
      }

      <slot />

      {
        (previous || next) && (
          <nav class="mt-16 grid gap-4 sm:grid-cols-2" aria-label={t.docs.pagination}>
            {previous ? (
              <a href={previous.href} class="pager">
                <span class="pager-label">← {t.docs.previous} · {previous.number}</span>
                <span class="pager-title">{previous.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={next.href} class="pager sm:text-right">
                <span class="pager-label">{t.docs.next} · {next.number} →</span>
                <span class="pager-title">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    <!-- Right rail -->
    <aside class="hidden w-48 shrink-0 xl:block">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pt-14 pb-8">
        <Toc headings={headings} />
      </div>
    </aside>
  </div>
</Base>

<style is:global>
  /* Prose styling is scoped to the article so it can't leak into the rails.
     Written against the tokens, so both themes come for free. */
  .doc-prose {
    max-width: 46rem;
    line-height: 1.7;
  }

  .doc-title {
    margin: 1.25rem 0 1rem;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .doc-prose .meta-link,
  .doc-prose .pager {
    text-decoration: none;
  }

  .pager {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.375rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .doc-prose a.pager {
    color: var(--ink);
  }
  .pager:hover {
    border-color: var(--accent);
    background: var(--accent-tint);
  }
  .pager-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pager-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .doc-prose h2 {
    margin: 3rem 0 0.875rem;
    font-size: 1.9rem;
    font-weight: 600;
    scroll-margin-top: 5rem;
  }

  .doc-prose h3 {
    margin: 2rem 0 0.5rem;
    font-size: 1.2rem;
    font-weight: 600;
    scroll-margin-top: 5rem;
  }

  .doc-prose p {
    margin: 0 0 1.1rem;
  }

  .doc-prose > p:not([class]),
  .doc-prose > ul:not([class]),
  .doc-prose > ol:not([class]) {
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .doc-prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .doc-prose a:hover {
    color: var(--accent-deep);
  }

  .doc-prose ul,
  .doc-prose ol {
    margin: 0 0 1.1rem;
    padding-left: 1.4rem;
  }

  .doc-prose li {
    margin: 0.3rem 0;
  }

  .doc-prose :not(pre) > code {
    font-size: 0.86em;
    background: var(--accent-tint);
    color: var(--accent);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  .doc-prose pre {
    margin: 0 0 1.35rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  /* The wrapper comes from wrapTables in astro.config.mjs. It scrolls, so the
     table never has to, and it carries the same frame as the facts box and the
     options list on a node page. */
  .doc-prose .table-scroll {
    margin: 0 0 1.35rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    overflow-x: auto;
  }

  .doc-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .doc-prose th,
  .doc-prose td {
    padding: 0.55rem 0.85rem;
    text-align: left;
    vertical-align: top;
    /* German and Dutch compounds outrun a phone-width column otherwise. The
       limit keeps ordinary words like "artifact" whole. */
    hyphens: auto;
    hyphenate-limit-chars: 12 5 5;
  }

  .doc-prose tbody tr > * {
    border-top: 1px solid var(--border);
  }

  /* A hyphen in a name reads as part of it. */
  .doc-prose td code {
    hyphens: manual;
  }
  .doc-prose th {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    background: var(--surface-2);
  }

  .doc-prose blockquote {
    margin: 0 0 1.35rem;
    padding: 0.9rem 1.15rem;
    border: 0;
    border-left: 3px solid var(--accent-solid);
    border-radius: 0 4px 4px 0;
    background: var(--accent-tint);
  }

  .doc-prose blockquote p:last-child {
    margin-bottom: 0;
  }

</style>
