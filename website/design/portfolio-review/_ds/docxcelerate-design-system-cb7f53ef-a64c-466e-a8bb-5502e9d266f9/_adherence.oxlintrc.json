{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/navigation/**",
              "components/product/**",
              "ui_kits/preview-app/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|shape|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, shape, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:outline|reversed|accent)$/]",
        "message": "<Badge> tone must be one of 'outline' | 'reversed' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|square)$/]",
        "message": "<Badge> shape must be one of 'pill' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|quiet|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'quiet' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|interactive|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, interactive, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:surface|paper)$/]",
        "message": "<Card> variant must be one of 'surface' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeSpan'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|tone|key|ref|className|style|children)$/]",
        "message": "<CodeSpan> doesn't accept that prop. Declared props: text, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyField'] > JSXAttribute > JSXIdentifier[name!=/^(?:command|prompt|labelIdle|labelCopied|style|key|ref|className|style|children)$/]",
        "message": "<CopyField> doesn't accept that prop. Declared props: command, prompt, labelIdle, labelCopied, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiffHunk'] > JSXAttribute > JSXIdentifier[name!=/^(?:file|removed|added|key|ref|className|style|children)$/]",
        "message": "<DiffHunk> doesn't accept that prop. Declared props: file, removed, added."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|blurb|href|style|key|ref|className|style|children)$/]",
        "message": "<DocCard> doesn't accept that prop. Declared props: index, title, blurb, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|title|key|ref|className|style|children)$/]",
        "message": "<SidebarPage> doesn't accept that prop. Declared props: slug, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: index, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|muted)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreeNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|id|label|depth|sector|children|key|ref|className|style|children)$/]",
        "message": "<TreeNode> doesn't accept that prop. Declared props: kind, id, label, depth, sector, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreeNode'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:dir|document|file)$/]",
        "message": "<TreeNode> kind must be one of 'dir' | 'document' | 'file'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LicenceSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:licence|copyright|pages|verbs|readLabel|readHref|style|key|ref|className|style|children)$/]",
        "message": "<LicenceSheet> doesn't accept that prop. Declared props: licence, copyright, pages, verbs, readLabel, readHref, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|accentColor|title|style|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: height, accentColor, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|figure|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: title, detail, figure."
      },
      {
        "selector": "JSXOpeningElement[name.name='TocHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|text|depth|key|ref|className|style|children)$/]",
        "message": "<TocHeading> doesn't accept that prop. Declared props: slug, text, depth."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:path|hint|children|style|key|ref|className|style|children)$/]",
        "message": "<PanelBar> doesn't accept that prop. Declared props: path, hint, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|scale|children|style|key|ref|className|style|children)$/]",
        "message": "<PaperPage> doesn't accept that prop. Declared props: title, scale, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<PillTabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|portrait|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: quote, name, role, portrait, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|external|soon|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href, external, soon."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|external|icon|soon|current|key|ref|className|style|children)$/]",
        "message": "<HeaderLink> doesn't accept that prop. Declared props: label, href, external, icon, soon, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderLink'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:github)$/]",
        "message": "<HeaderLink> icon must be one of 'github'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|weight|as|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, weight, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:theme|reversed)$/]",
        "message": "<Wordmark> tone must be one of 'theme' | 'reversed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WordShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|live|pageWidth|children|style|key|ref|className|style|children)$/]",
        "message": "<WordShell> doesn't accept that prop. Declared props: title, live, pageWidth, children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
